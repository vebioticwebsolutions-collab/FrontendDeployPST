---
import Layout from '../../layouts/Layout.astro';
import staircase from '../../assets/home-page/staircase buyers guide image.jpg';
import ringlock from '../../assets/home-page/ringlock pic buyers guide.jpg';
import walkway from '../../assets/home-page/walkway buyer guide image.jpg';
---

<Layout title="Scaffolding Staircase Tower Buyer's Guide | Prime Steel Tech">

<main class="bg-slate-50 min-h-screen pt-20 text-slate-600">

  <section class="py-20 border-b border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <div>
          <img
            src={staircase.src}
            alt="Cuplock Scaffolding Staircase Tower"
            class="w-full h-[500px] object-cover rounded-sm border border-slate-200 shadow-2xl"
          />
        </div>

        <div>

          <span class="inline-flex px-4 py-2 rounded-full border border-emerald-200 bg-emerald-50 text-emerald-600 uppercase tracking-widest text-xs font-bold mb-6">
             Buyer's Guide
          </span>

          <h1 class="text-4xl lg:text-6xl font-black text-slate-900 uppercase leading-tight mb-8">
            What is <br/>
            <span class="text-emerald-600">
              Scaffolding Staircase Tower?
            </span>
          </h1>

          <p class="font-jakarta text-slate-600 leading-relaxed text-base mb-6 text-justify">
            A Scaffolding Staircase Tower is a heavy-duty, modular vertical access system designed to provide safe, temporary passage for workers and materials between different structural levels. Utilizing high-strength medium-class steel pipes and advanced connection nodes, it ensures secure access on intensive job sites.
          </p>

          <p class="font-jakarta text-slate-600 leading-relaxed text-justufy">
            Engineered with an premium anti-skid dimple platform finish, full double-sided guardrails, and secure anchorage tie bars, our towers are optimized for superior load-bearing capacity and fast, tool-free assembly. They completely replace unsafe vertical ladders across construction, industrial, and offshore projects.
          </p>

          <div class="mt-8">
            <a
              href="/pdfs/Staircase-Buyers-Guide.pdf"
              download="Prime-Steel-Tech-Staircase-Tower-Datasheet.pdf"
              class="inline-flex items-center gap-3 rounded-sm
              bg-emerald-600 px-8 py-4
              text-sm font-extrabold
              text-white
              hover:bg-emerald-500
              transition-all duration-300
              uppercase tracking-widest"
            >
              Download Datasheet PDF
            </a>
          </div>

          <div class="grid grid-cols-2 gap-4 mt-10">

            <div class="bg-white p-4 rounded-sm border border-slate-200">
              <div class="text-emerald-600 font-bold">Anti-Skid Dimple</div>
              <div class="text-sm text-slate-600 mt-1">
                Secure grip in wet & dusty conditions
              </div>
            </div>

            <div class="bg-white p-4 rounded-sm border border-slate-200">
              <div class="text-emerald-600 font-bold">450 kg UDL</div>
              <div class="text-sm text-slate-600 mt-1">
                Heavy-duty design platform capacity
              </div>
            </div>

            <div class="bg-white p-4 rounded-sm border border-slate-200">
              <div class="text-emerald-600 font-bold">Full Fall Protection</div>
              <div class="text-sm text-slate-600 mt-1">
                Guardrails & 150mm toe guards
              </div>
            </div>

            <div class="bg-white p-4 rounded-sm border border-slate-200">
              <div class="text-emerald-600 font-bold">Dual Finish Protection</div>
              <div class="text-sm text-slate-600 mt-1">
                Red-Oxide and Orange Enamel paint
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </section>


  <section class="py-20 bg-white">

    <div class="mx-auto max-w-5xl px-4">

      <div class="text-center mb-14">

        <h2 class="text-3xl font-black text-slate-900 uppercase">
          Why Choose Our
          <span class="text-emerald-600 ml-2">Staircase Towers?</span>
        </h2>

        <div class="h-1 w-12 bg-emerald-400 mx-auto mt-5 rounded-full"></div>

      </div>

      <div class="bg-slate-50 border border-slate-200 p-10 rounded-sm text-justify">

        <p class="font-jakarta text-slate-600 text-base leading-loose">
          Cuplock precision, engineered for every site. A single cup locks up to 4 ledgers at once, so assembly is fast and completely tool free across our full range. Choose the tread surface that fits your conditions, from anti-skid dimple and checkered plate to self-draining pipe grating, and the safety configuration that fits your budget and site requirements. Every model is built to IS, BS EN, and OSHA standards and backed by ISO 9001 certification, so you get the right tower for the job .
        </p>

      </div>

    </div>

  </section>


  <section class="py-20">

    <div class="mx-auto max-w-6xl px-4">

      <div class="mb-10">

        <h2 class="text-3xl font-black text-slate-900 uppercase">
          Prime SteelTech Apex-Tower
          <span class="text-emerald-600 ml-2">
            Specifications
          </span>
        </h2>

      </div>


      <div class="overflow-auto rounded-sm border border-slate-200">

        <table class="w-full font-jakarta">

          <thead class="bg-emerald-50">
            <tr>
              <th class="px-6 py-4 text-left text-emerald-600 uppercase text-xs">
                Parameter
              </th>
              <th class="px-6 py-4 text-left text-emerald-600 uppercase text-xs">
                General Specification
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">

            <tr>
              <td class="px-6 py-4">Primary Material</td>
              <td class="px-6 py-4">M.S Pipe (IS 1161 Grade YST210)</td>
            </tr>

            <tr>
              <td class="px-6 py-4">Tube Outer Diameter</td>
              <td class="px-6 py-4">48.3 mm</td>
            </tr>

            <tr>
              <td class="px-6 py-4">Configuration</td>
              <td class="px-6 py-4">APEX, 8-Leg Cuplock</td>
            </tr>

            <tr>
              <td class="px-6 py-4">Grid Size (L x W)</td>
              <td class="px-6 py-4">3,800 x 2,200 mm</td>
            </tr>

            <tr>
              <td class="px-6 py-4">Platform Height / Overall Tower Height</td>
              <td class="px-6 py-4"> Platform height + 1,500 mm (top rail)</td>
            </tr>

            <tr>
              <td class="px-6 py-4">Stair Width & Material</td>
              <td class="px-6 py-4">900 mm clear / M.S. Checkered Plate (Anti-Skid, IS 3502)</td>
            </tr>

            <tr>
              <td class="px-6 py-4">Platform Design Load (UDL)</td>
              <td class="px-6 py-4">450 kg/m² (4.41 kN/m²) </td>
            </tr>

            <tr>
              <td class="px-6 py-4">Surface Protection Finish</td>
              <td class="px-6 py-4">Red Oxide and orange paint</td>
            </tr>

            <tr>
              <td class="px-6 py-4">Components & Locking Type</td>
              <td class="px-6 py-4">Drop-Forged Steel Top Cup / Pressed Metal Bottom Cup</td>
            </tr>

            <tr>
              <td class="px-6 py-4">Regulatory Compliance</td>
              <td class="px-6 py-4">IS 1161, IS 2750, IS 3502, IS 3696, IS 4014, BS EN 12811-1, BS 1139-3, OSHA 29 CFR 1926.451, ISO 9001:2015</td>
            </tr>

          </tbody>

        </table>

      </div>

    </div>

  </section>


  <section class="py-20 bg-white">

    <div class="mx-auto max-w-6xl px-4">

      <h2 class="text-3xl font-black text-slate-900 mb-10 uppercase">
        Available Tower
        <span class="text-emerald-600 ml-2">
          Configurations
        </span>
      </h2>


      <div class="overflow-auto rounded-sm border border-slate-200">

        <table class="w-full font-jakarta">

          <thead class="bg-emerald-50">
            <tr>
              <th class="px-6 py-4 text-left text-emerald-600 uppercase text-xs">Configuration Parameter</th>
              <th class="px-6 py-4 text-left text-emerald-600 uppercase text-xs">Economy</th>
              <th class="px-6 py-4 text-left text-emerald-600 uppercase text-xs">Alpha 4 Leg</th>
              <th class="px-6 py-4 text-left text-emerald-600 uppercase text-xs">Alpha 8 Leg</th>
              <th class="px-6 py-4 text-left text-emerald-600 uppercase text-xs">Premium 4 Leg</th>
              <th class="px-6 py-4 text-left text-emerald-600 uppercase text-xs">Premium 8 Leg</th>
              <th class="px-6 py-4 text-left text-emerald-600 uppercase text-xs">Apex</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">

            <tr>
              <td class="px-6 py-4 font-bold text-slate-900">Number of Vertical Legs</td>
              <td class="px-6 py-4">4 Legs</td>
              <td class="px-6 py-4">4 Legs</td>
              <td class="px-6 py-4">8 Legs</td>
              <td class="px-6 py-4">4 Legs</td>
              <td class="px-6 py-4">8 Legs</td>
              <td class="px-6 py-4">8 Legs</td>
            </tr>

            <tr>
              <td class="px-6 py-4 font-bold text-slate-900">Grid Layout Size (L x W)</td>
              <td class="px-6 py-4">2,000 x 1,500 mm</td>
              <td class="px-6 py-4">2,500 x 1,800 mm</td>
              <td class="px-6 py-4">3,800 x 1,800 mm</td>
              <td class="px-6 py-4">2,500 x 2,000 mm</td>
              <td class="px-6 py-4">2,000 x 3,800 mm</td>
              <td class="px-6 py-4">3,800 x 2,200 mm</td>
            </tr>

            <tr>
              <td class="px-6 py-4 font-bold text-slate-900">Staircase Step Rise</td>
              <td class="px-6 py-4">295 mm</td>
              <td class="px-6 py-4">237 mm (Class-B EN 12811-1)</td>
              <td class="px-6 py-4">206 mm (Class-B EN 12811-1)</td>
              <td class="px-6 py-4">230 mm (Class-B EN 12811-1)</td>
              <td class="px-6 py-4">205 mm (Class-B EN 12811-1)</td>
              <td class="px-6 py-4">205 mm (Class-B EN 12811-1)</td>
            </tr>

            <tr>
              <td class="px-6 py-4 font-bold text-slate-900">Staircase Pitch/Angle</td>
              <td class="px-6 py-4">54° Angle</td>
              <td class="px-6 py-4">49° Angle</td>
              <td class="px-6 py-4">41° Angle</td>
              <td class="px-6 py-4">49° Angle</td>
              <td class="px-6 py-4">41° Angle</td>
              <td class="px-6 py-4">41° Angle</td>
            </tr>

            <tr>
              <td class="px-6 py-4 font-bold text-slate-900">Landing Platform Depth</td>
              <td class="px-6 py-4">450 mm (in direction of travel)</td>
              <td class="px-6 py-4">600 mm (in direction of travel)</td>
              <td class="px-6 py-4">1,000 mm (in direction of travel)</td>
              <td class="px-6 py-4">600 mm (in direction of travel)</td>
              <td class="px-6 py-4">1000 mm (in direction of travel)</td>
              <td class="px-6 py-4">1,000 mm (in direction of travel)</td>
            </tr>

            <tr>
              <td class="px-6 py-4 font-bold text-slate-900">Landing Platform Width</td>
              <td class="px-6 py-4">1,250 mm</td>
              <td class="px-6 py-4">1,450 mm</td>
              <td class="px-6 py-4">1,800 mm</td>
              <td class="px-6 py-4">2,000 mm</td>
              <td class="px-6 py-4">2,000 mm</td>
              <td class="px-6 py-4">2,200 mm</td>
            </tr>

          </tbody>

        </table>

      </div>

    </div>

  </section>


  <section class="py-20">

    <div class="mx-auto max-w-7xl px-4">

      <div class="text-center mb-14">

        <h2 class="text-3xl font-black text-slate-900 uppercase">
          Factors to Consider Before Buying
          <span class="text-emerald-600 ml-2">
            Staircase Towers
          </span>
        </h2>

      </div>

      <div class="space-y-6 mt-12">

        <div class="bg-white border border-slate-200 rounded-sm p-8 hover:border-emerald-400 transition-all">
          <h3 class="text-xl font-bold text-slate-900 mb-3 uppercase">
            01. Grid Size & Layout Constraints
          </h3>
          <p class="font-jakarta text-slate-600 leading-relaxed">
            Assess the space limitations of your job site. The 4-leg configuration (Premium-4) utilizes a 2,500 x 2,000 mm footprint which is ideal for tight structural spacing, whereas the heavy-duty 8-leg configuration (Premium-8) requires a wider 2,000 x 3,800 mm footprint.
          </p>
        </div>

        <div class="bg-white border border-slate-200 rounded-sm p-8 hover:border-emerald-400 transition-all">
          <h3 class="text-xl font-bold text-slate-900 mb-3 uppercase">
            02. Height & Anchorage Requirements
          </h3>
          <p class="font-jakarta text-slate-600 leading-relaxed">
            Ensure your configuration aligns with standard heights or requests customized extensions. Remember that structural tie bars are mandatory once the total tower height exceeds 3 times the least base dimension, with specific wall attachment rules up to 4 m vertically.
          </p>
        </div>

        <div class="bg-white border border-slate-200 rounded-sm p-8 hover:border-emerald-400 transition-all">
          <h3 class="text-xl font-bold text-slate-900 mb-3 uppercase">
            03. Uniformly Distributed Load (UDL)
          </h3>
          <p class="font-jakarta text-slate-600 leading-relaxed">
            Evaluate the density of worker traffic and tool transportation. Prime Steel Tech towers feature a high platform UDL of 450 kg/m², strictly meeting Class-B global standard compliance for multi-worker movement.
          </p>
        </div>

        <div class="bg-white border border-slate-200 rounded-sm p-8 hover:border-emerald-400 transition-all">
          <h3 class="text-xl font-bold text-slate-900 mb-3 uppercase">
            04. Compliance & On-Site Legislation
          </h3>
          <p class="font-jakarta text-slate-600 leading-relaxed">
            Verify that your safety code mandates align with local regulations. These towers conform strictly to regional Indian Standards (IS 3696/4014) mandated under OSHA, alongside global standardizations including EN 12811-1 and US OSHA.
          </p>
        </div>

      </div>

    </div>

  </section>



  <section class="py-20 bg-white">

    <div class="mx-auto max-w-7xl px-4">

      <h2 class="text-3xl text-center font-black text-slate-900 uppercase mb-16">
        Industries Using
        <span class="text-emerald-600 ml-2">
          Staircase Towers
        </span>
      </h2>

      <div class="grid md:grid-cols-4 gap-6">

        <div class="bg-slate-50 p-8 border border-slate-200 rounded-sm">
          <h3 class="text-slate-900 font-bold mb-3">Civil Infrastructure</h3>
          <p class="text-slate-600 text-sm">
            High-rise residential builds, bridges, flyovers, and metro viaduct networks.
          </p>
        </div>

        <div class="bg-slate-50 p-8 border border-slate-200 rounded-sm">
          <h3 class="text-slate-900 font-bold mb-3">Data Centres</h3>
          <p class="text-slate-600 text-sm">
            Refineries, petrochemical processing zones, cement factories, and power hubs.
          </p>
        </div>

        <div class="bg-slate-50 p-8 border border-slate-200 rounded-sm">
          <h3 class="text-slate-900 font-bold mb-3">Marine Fabrication</h3>
          <p class="text-slate-600 text-sm">
            Ship construction, shipyard maintenance, dockyard works, and offshore platforms.
          </p>
        </div>

        <div class="bg-slate-50 p-8 border border-slate-200 rounded-sm">
          <h3 class="text-slate-900 font-bold mb-3">Specialized Sectors</h3>
          <p class="text-slate-600 text-sm">
            Nuclear energy sites, defence structures, and aircraft hangar staging.
          </p>
        </div>

      </div>

    </div>

  </section>


  <!-- EXPLORE OTHER BUYER'S GUIDES -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 uppercase tracking-tight">Explore Our Other <span class="text-emerald-600 ml-2">Buyer's Guides</span></h2>
        <a href="/products" class="hidden sm:block text-xs font-bold text-slate-600 hover:text-emerald-600 transition-colors uppercase tracking-widest">View Full Catalog &rarr;</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

        <a href="/products/ringlock-guide" class="group relative overflow-hidden rounded-sm aspect-[21/9] sm:aspect-[16/9] bg-slate-200 shadow-lg border border-emerald-200 flex items-end p-6 sm:p-8">
          <img src={ringlock.src} class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-60 group-hover:scale-105 transition-all duration-700 z-0" alt="Ringlock Scaffolding Buyer's Guide" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent z-10"></div>
          <div class="relative z-20">
            <span class="block text-[10px] font-bold text-emerald-600 uppercase tracking-widest mb-1">Buyer's Guide</span>
            <h3 class="text-xl font-bold text-white uppercase tracking-wide group-hover:text-emerald-600 transition-colors">Ringlock Scaffolding</h3>
          </div>
          <div class="absolute bottom-6 sm:bottom-8 right-6 sm:right-8 z-20 w-10 h-10 rounded-full bg-emerald-100/60 flex items-center justify-center border border-emerald-200 group-hover:bg-emerald-500 group-hover:border-emerald-500 transition-colors">
            <svg class="w-5 h-5 text-white group-hover:text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </div>
        </a>

        <a href="/products/walkway-guide" class="group relative overflow-hidden rounded-sm aspect-[21/9] sm:aspect-[16/9] bg-slate-200 shadow-lg border border-emerald-200 flex items-end p-6 sm:p-8">
          <img src={walkway.src} class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-60 group-hover:scale-105 transition-all duration-700 z-0" alt="Walkway Planks Buyer's Guide" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent z-10"></div>
          <div class="relative z-20">
            <span class="block text-[10px] font-bold text-emerald-600 uppercase tracking-widest mb-1">Buyer's Guide</span>
            <h3 class="text-xl font-bold text-white uppercase tracking-wide group-hover:text-emerald-600 transition-colors">Walkway Planks</h3>
          </div>
          <div class="absolute bottom-6 sm:bottom-8 right-6 sm:right-8 z-20 w-10 h-10 rounded-full bg-emerald-100/60 flex items-center justify-center border border-emerald-200 group-hover:bg-emerald-500 group-hover:border-emerald-500 transition-colors">
            <svg class="w-5 h-5 text-white group-hover:text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </div>
        </a>

      </div>
    </div>
  </section>


</main>

</Layout>


<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
.font-jakarta {
  font-family: 'Plus Jakarta Sans', sans-serif;
}
</style>
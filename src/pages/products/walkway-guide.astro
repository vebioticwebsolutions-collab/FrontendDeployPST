---
import Layout from '../../layouts/Layout.astro';
import ringlock from '../../assets/home-page/ringlock pic buyers guide.jpg';
import walkway from '../../assets/home-page/walkway buyer guide image.jpg';
import staircase from '../../assets/home-page/staircase buyers guide image.jpg';
---

<Layout title="Walkway Planks Buyer's Guide | Prime Steel Tech">
<main class="bg-slate-50 min-h-screen pt-20 text-slate-600">
<section class="py-16 sm:py-24 border-b border-slate-200 relative overflow-hidden">
<div class="absolute top-0 right-0 w-[600px] h-[600px] bg-emerald-50 blur-[120px] rounded-full"></div>
<div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
<div><img src={walkway.src} class="w-full rounded-sm border border-slate-200" /></div>
<div>
<div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-[11px] font-semibold text-emerald-600 uppercase tracking-widest mb-6">Buyer's Guide</div>
<h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 uppercase tracking-tight mb-6 leading-[1.1]">What are <span class="text-emerald-600">Walkway Planks?</span></h1>
<p class="font-jakarta text-slate-600 text-sm sm:text-base leading-relaxed mb-6">Anti-Skid Walkway Planks are safe working platforms used in scaffolding systems for construction and industrial access. The GP plank is manufactured from IS 277:1951 pre-galvanised  sheet with hooks in IS 2062 Grade E250, and anti-slip perforated surfaces provide excellent grip, durability and corrosion resistance.</p>
<p class="font-jakarta text-slate-600 text-sm leading-relaxed">Compatible with Ringlock, Cuplock, Tube-and-Coupler and H-Frame Scaffolding systems. Manufactured in compliance with IS 3696, IS 4014, IS 816, BS EN 12811-1, ANSI A10.8-2019 and OSHA 29 CFR 1926 Subclause L.</p>

            <div class="flex mt-8">
              <a href="/pdfs/Walkway-Buyers-Guide.pdf" download class="group inline-flex h-12 items-center justify-center gap-2 rounded-[3px] bg-emerald-600 px-8 text-[13px] font-bold text-white uppercase tracking-widest hover:bg-emerald-500 transition-colors shadow-lg">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                DOWNLOAD BUYER'S GUIDE
              </a>
            </div>

</div></div></div></section>
<section class="py-16 bg-white"><div class="mx-auto max-w-5xl px-4"><h2 class="text-3xl font-black text-slate-900 uppercase text-center mb-10">Why Steel Walkway Planks are Better than <span class="text-emerald-600">Traditional Wooden Planks</span></h2><div class="bg-slate-50 border border-slate-200 rounded-sm p-8"><p class="font-jakarta text-slate-600 leading-loose">Steel walkway planks offer a safer, stronger, and more durable alternative to traditional wooden planks on construction sites. Unlike wood, steel does not absorb water or swell during the rainy season, preventing a significant increase in dead weight that makes wooden planks harder to handle and more prone to structural issues. Steel planks also provide higher load-bearing capacity, better slip resistance, and superior fire resistance</p></div></div></section>
<section class="py-16"><div class="mx-auto max-w-6xl px-4">
  <h2 class="text-3xl font-black text-slate-900 uppercase mb-8">Technical <span class="text-emerald-600">Specifications</span></h2>
  <div class="overflow-auto rounded-sm border border-slate-200 bg-white">
    <table class="w-full font-jakarta text-sm">
      <thead><tr class="bg-emerald-50 border-b border-slate-200">
        <th class="px-6 py-4 text-left text-xs font-bold text-slate-900 uppercase tracking-wider">Parameter</th>
        <th class="px-6 py-4 text-left text-xs font-bold text-slate-900 uppercase tracking-wider">Specification</th>
      </tr></thead>
      <tbody class="divide-y divide-slate-100 text-slate-600">
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Steel Grade (GP Sheet)</td><td class="px-6 py-4 text-sm">IS 277:1951</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Steel Grade (MS Sheet)</td><td class="px-6 py-4 text-sm">IS 2062 E250</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Steel Grade (Hooks)</td><td class="px-6 py-4 text-sm">IS 2062 E250, Hot Rolled</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Sheet Thickness</td><td class="px-6 py-4 text-sm">14/16 Gauge — 2 mm / 1.6 mm</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Board Width</td><td class="px-6 py-4 text-sm">300 / 280 / 240 mm</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Board Lengths</td><td class="px-6 py-4 text-sm">1000/1250 / 2000 / 2500 / 3000 mm · Custom on request</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Self-Weight (2000 × 300 mm plank)</td><td class="px-6 py-4 text-sm">15.5 kg without hooks · 16.5 kg with hooks</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Hook Type / Fixing</td><td class="px-6 py-4 text-sm">Without hooks: BRC clamp fixing · With hooks: Hook 60 (both ends), Hemispherical or Dog-Ear profile, 6 mm thick</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Rib Profile / Height</td><td class="px-6 py-4 text-sm">2-fold / 3-fold · 38 mm standard, with 42 / 45 / 50 mm options</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Anti-Skid Dimple Density</td><td class="px-6 py-4 text-sm">246.11 dimples / m² · 32.5 mm × 50 mm spacing (Antiskid Dimple Plate)</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Galvanising</td><td class="px-6 py-4 text-sm">Min 45 µm zinc · Pre Galvanised · EN ISO 1461</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Welding</td><td class="px-6 py-4 text-sm">U-section stiffeners, MIG/MAG fillet-welded per IS 816 · aluminium-rich paint touch-up on welds</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Stiffener Spacing</td><td class="px-6 py-4 text-sm">500 mm c/c transverse · Longitudinal added when width &gt; 400 mm</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Live Load Design Basis</td><td class="px-6 py-4 text-sm"> Upto 450 kg/m² UDL </td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Deflection Limit</td><td class="px-6 py-4 text-sm">Span / 60 service load · capped at 10–15 mm overall (IS 3696-1987)</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Max Plank Gap</td><td class="px-6 py-4 text-sm">25 mm</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Overhang</td><td class="px-6 py-4 text-sm">50 mm min / 150 mm max</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">Compatible Systems</td><td class="px-6 py-4 text-sm">Tube-and-Coupler · Cuplock ·H-Frame Scaffold · Ringlock</td></tr>
      </tbody>
    </table>
  </div>
</div></section>

<section class="py-16 bg-white"><div class="mx-auto max-w-6xl px-4">
  <h2 class="text-3xl font-black text-slate-900 uppercase mb-8">AntiSkid <span class="text-emerald-600">Surface Options</span></h2>
  <div class="overflow-auto rounded-sm border border-slate-200 bg-white">
    <table class="w-full font-jakarta text-sm">
      <thead><tr class="bg-emerald-50 border-b border-slate-200">
        <th class="px-6 py-4 text-left text-xs font-bold text-slate-900 uppercase tracking-wider">Surface Type</th>
        <th class="px-6 py-4 text-center text-xs font-bold text-slate-900 uppercase tracking-wider">Availability</th>
        <th class="px-6 py-4 text-center text-xs font-bold text-slate-900 uppercase tracking-wider">Deck Type</th>
        <th class="px-6 py-4 text-center text-xs font-bold text-slate-900 uppercase tracking-wider">Drainage</th>
        <th class="px-6 py-4 text-left text-xs font-bold text-slate-900 uppercase tracking-wider">Best For</th>
      </tr></thead>
      <tbody class="divide-y divide-slate-100 text-slate-600">
        <tr class="hover:bg-slate-50 transition-colors">
          <td class="px-6 py-4">
            <span class="block text-sm font-semibold text-slate-900">Antiskid Dimple Plate</span>
            <span class="text-xs text-slate-400 mt-0.5 block">Hemispherical cold-pressed dimples with round perforations · <span class="text-emerald-600 font-semibold">246.11 dimples/m² · 65 × 50 mm spacing</span></span>
          </td>
          <td class="px-6 py-4 text-center"><span class="px-2.5 py-1 bg-emerald-50 text-emerald-600 text-[10px] font-black uppercase tracking-widest rounded-sm">Standard</span></td>
          <td class="px-6 py-4 text-center text-sm text-slate-600">Perforated</td>
          <td class="px-6 py-4 text-center text-sm text-slate-600">Omnidirectional</td>
          <td class="px-6 py-4 text-sm text-slate-600">General scaffolding platforms, construction sites</td>
        </tr>
        <tr class="hover:bg-slate-50 transition-colors">
          <td class="px-6 py-4">
            <span class="block text-sm font-semibold text-slate-900">Diamond Checker Plate</span>
            <span class="text-xs text-slate-400 mt-0.5 block">Diamond-pattern embossed anti-slip surface</span>
          </td>
          <td class="px-6 py-4 text-center"><span class="px-2.5 py-1 bg-slate-100 text-slate-600 text-[10px] font-black uppercase tracking-widest rounded-sm">On Request</span></td>
          <td class="px-6 py-4 text-center text-sm text-slate-600">Solid</td>
          <td class="px-6 py-4 text-center text-sm text-slate-600">Longitudinal &amp; transverse</td>
          <td class="px-6 py-4 text-sm text-slate-600">Stair towers, access walkways, high-traffic areas</td>
        </tr>
        <tr class="hover:bg-slate-50 transition-colors">
          <td class="px-6 py-4">
            <span class="block text-sm font-semibold text-slate-900">Checker Plate</span>
            <span class="text-xs text-slate-400 mt-0.5 block">Parallel raised ribs with linear drainage channels</span>
          </td>
          <td class="px-6 py-4 text-center"><span class="px-2.5 py-1 bg-slate-100 text-slate-600 text-[10px] font-black uppercase tracking-widest rounded-sm">On Request</span></td>
          <td class="px-6 py-4 text-center text-sm text-slate-600">Solid</td>
          <td class="px-6 py-4 text-center text-sm text-slate-600">Directional (channel)</td>
          <td class="px-6 py-4 text-sm text-slate-600">Oil &amp; gas plants, food-processing walkways</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="font-jakarta text-xs text-slate-400 mt-4">All types available in widths 240 / 280 / 300 mm and lengths 1250 / 2000 / 2500 / 3000 mm. Custom lengths on request.</p>

  <h3 class="text-2xl font-black text-slate-900 uppercase mt-16 mb-8">Available  <span class="text-emerald-600">Walkway Planks</span></h3>
  <div class="overflow-auto rounded-sm border border-slate-200 bg-white">
    <table class="w-full font-jakarta text-sm">
      <thead><tr class="bg-emerald-50 border-b border-slate-200">
        <th class="px-6 py-4 text-left text-xs font-bold text-slate-900 uppercase tracking-wider">Length</th>
        <th class="px-6 py-4 text-left text-xs font-bold text-slate-900 uppercase tracking-wider">Width</th>
        <th class="px-6 py-4 text-left text-xs font-bold text-slate-900 uppercase tracking-wider">Height (Rib)</th>
        <th class="px-6 py-4 text-left text-xs font-bold text-slate-900 uppercase tracking-wider">Edge Treatment</th>
      </tr></thead>
      <tbody class="divide-y divide-slate-100 text-slate-600">
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">3000 mm</td><td class="px-6 py-4 text-sm">300 / 280 / 240 mm</td><td class="px-6 py-4 text-sm">38 mm (Standard) / 42 / 45 / 50 mm</td><td class="px-6 py-4 text-sm">Double/Triple Bent Edges, Fully Welded Corners</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">2500 mm</td><td class="px-6 py-4 text-sm">300 / 280 / 240 mm</td><td class="px-6 py-4 text-sm">38 mm (Standard) / 42 / 45 / 50 mm</td><td class="px-6 py-4 text-sm">Double/Triple Bent Edges, Fully Welded Corners</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">2000 mm</td><td class="px-6 py-4 text-sm">300 / 280 / 240 mm</td><td class="px-6 py-4 text-sm">38 mm (Standard) / 42 / 45 / 50 mm</td><td class="px-6 py-4 text-sm">Double/Triple Bent Edges, Fully Welded Corners</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">1250 mm</td><td class="px-6 py-4 text-sm">300 / 280 / 240 mm</td><td class="px-6 py-4 text-sm">38 mm (Standard) / 42 / 45 / 50 mm</td><td class="px-6 py-4 text-sm">Double/Triple Bent Edges, Fully Welded Corners</td></tr>
        <tr class="hover:bg-slate-50 transition-colors"><td class="px-6 py-4 text-sm font-semibold text-slate-900">1000 mm</td><td class="px-6 py-4 text-sm">300 / 280 / 240 mm</td><td class="px-6 py-4 text-sm">38 mm (Standard) / 42 / 45 / 50 mm</td><td class="px-6 py-4 text-sm">Double/Triple Bent Edges, Fully Welded Corners</td></tr>
      </tbody>
    </table>
  </div>
  <p class="font-jakarta text-xs text-slate-400 mt-4">Deck thickness (all lengths): 14/16 Gauge — 2 mm / 1.6 mm. ★ Custom lengths available on request.</p>
</div></section>

<section class="py-16 bg-slate-50"><div class="mx-auto max-w-7xl px-4"><h2 class="text-3xl font-black text-slate-900 uppercase text-center mb-12">Factors to Consider Before Buying <span class="text-emerald-600">Walkway Planks</span></h2><div class="space-y-6"><div class="bg-white p-8 rounded-sm border border-slate-200"><h3 class="text-xl font-bold text-slate-900 mb-3 uppercase">01. Surface Grip</h3><p class="font-jakarta text-slate-600 text-sm leading-relaxed">Choose anti-slip perforated surfaces for safe footing in all weather conditions. Antiskid Dimple Plate is the standard choice for most scaffolding applications.</p></div><div class="bg-white p-8 rounded-sm border border-slate-200"><h3 class="text-xl font-bold text-slate-900 mb-3 uppercase">02. Load Capacity</h3><p class="font-jakarta text-slate-600 text-sm leading-relaxed">Select planks with adequate safe working load for your platform. All Prime Steeltech planks are checked for bending stress, shear at supports and deflection against a design basis of upto 450 kg/m² UDL , with deflection capped at Span/60.</p></div><div class="bg-white p-8 rounded-sm border border-slate-200"><h3 class="text-xl font-bold text-slate-900 mb-3 uppercase">03. Corrosion Resistance</h3><p class="font-jakarta text-slate-600 text-sm leading-relaxed">Pre-galvanised planks with min 45 µm zinc coating (EN ISO 1461) resist rust in wet and industrial conditions. Welded stiffener joints receive an aluminium-rich paint touch-up to protect the heat-affected zone. Critical for coastal, chemical and industrial environments.</p></div><div class="bg-white p-8 rounded-sm border border-slate-200"><h3 class="text-xl font-bold text-slate-900 mb-3 uppercase">04. Compliance</h3><p class="font-jakarta text-slate-600 text-sm leading-relaxed">Choose planks complying with IS 3696, IS 4014, IS 816, BS EN 12811-1, ANSI A10.8-2019 and OSHA 29 CFR 1926 Subclause L. All Prime Steeltech walkway planks use IS 277:1951 GP deck sheet and IS 2062 E250 MS sheet and hooks, with MIG/MAG welding per IS 816.</p></div></div></div></section>

<section class="py-16 bg-white border-t border-slate-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 uppercase tracking-tight">Explore Our Other <span class="text-emerald-600">Buyer's Guides</span></h2>
      <a href="/products" class="hidden sm:block text-xs font-bold text-slate-600 hover:text-emerald-600 transition-colors uppercase tracking-widest">View Full Catalog &rarr;</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

      <a href="/products/ringlock-guide" class="group relative overflow-hidden rounded-sm aspect-[21/9] sm:aspect-[16/9] bg-slate-200 shadow-lg border border-emerald-200 flex items-end p-6 sm:p-8">
        <img src={ringlock.src} class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-60 group-hover:scale-105 transition-all duration-700 z-0" alt="Ringlock Scaffolding Buyer's Guide" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent z-10"></div>
        <div class="relative z-20">
          <span class="block text-[10px] font-bold text-emerald-600 uppercase tracking-widest mb-1">Buyer's Guide</span>
          <h3 class="text-xl font-bold text-white uppercase tracking-wide group-hover:text-emerald-600 transition-colors">Ringlock Scaffolding</h3>
        </div>
        <div class="absolute bottom-6 sm:bottom-8 right-6 sm:right-8 z-20 w-10 h-10 rounded-full bg-emerald-100/60 flex items-center justify-center border border-emerald-200 group-hover:bg-emerald-500 group-hover:border-emerald-500 transition-colors">
          <svg class="w-5 h-5 text-white group-hover:text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </div>
      </a>

      <a href="/products/staircase-guide" class="group relative overflow-hidden rounded-sm aspect-[21/9] sm:aspect-[16/9] bg-slate-200 shadow-lg border border-emerald-200 flex items-end p-6 sm:p-8">
        <img src={staircase.src} class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-60 group-hover:scale-105 transition-all duration-700 z-0" alt="Staircase Tower Buyer's Guide" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent z-10"></div>
        <div class="relative z-20">
          <span class="block text-[10px] font-bold text-emerald-600 uppercase tracking-widest mb-1">Buyer's Guide</span>
          <h3 class="text-xl font-bold text-white uppercase tracking-wide group-hover:text-emerald-600 transition-colors">Staircase Towers</h3>
        </div>
        <div class="absolute bottom-6 sm:bottom-8 right-6 sm:right-8 z-20 w-10 h-10 rounded-full bg-emerald-100/60 flex items-center justify-center border border-emerald-200 group-hover:bg-emerald-500 group-hover:border-emerald-500 transition-colors">
          <svg class="w-5 h-5 text-white group-hover:text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </div>
      </a>

    </div>
  </div>
</section>

</main></Layout>
<style is:global>@import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"); .font-jakarta{font-family:'Plus Jakarta Sans',sans-serif;}</style>
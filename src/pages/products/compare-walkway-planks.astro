---
import Layout from '../../layouts/Layout.astro';

// ==========================================
// CUSTOM ASSET IMPORTS (placeholders — swap for dedicated model photography)
// ==========================================
import fold2Img from '../../assets/walkway/(updated)Walkway Plank GP Sheet.jpg';
import fold3Img from '../../assets/walkway/(updated)Walkway Plank Oil & Gas Refinery.jpg';
import noHookImg from '../../assets/walkway/without hook.jpg';
import cTypeHookImg from '../../assets/walkway/(updated)Walkway Plank Hook.jpg';
import dogEarHookImg from '../../assets/products/(updated) Walkway Plank Option 2 .jpg';
---

<Layout title="Compare Walkway Plank Models | Vertex by Primesteeltech">

  <main class="bg-slate-50 min-h-screen pt-24 pb-16 overflow-x-hidden font-jakarta">

    <!-- Hero / Header -->
    <section class="pb-12 sm:pb-16 border-b border-slate-200 relative">
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <nav class="mb-6 flex items-center justify-between flex-wrap gap-4">
          <div class="flex text-[10px] font-bold text-slate-500 uppercase tracking-widest">
            <a href="/products" class="hover:text-emerald-700 transition-colors">Products</a>
            <span class="mx-2 text-slate-300">/</span>
            <a href="/products/walkway-planks" class="hover:text-emerald-700 transition-colors">Walkway Planks</a>
            <span class="mx-2 text-slate-300">/</span>
            <span class="text-emerald-700">Compare</span>
          </div>

          <a href="/products/walkway-planks" class="inline-flex items-center gap-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest hover:text-emerald-700 transition-colors">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Back to Walkway Planks
          </a>
        </nav>

        <div class="max-w-3xl">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 uppercase tracking-tight mb-4 leading-[1.1]">
            Compare Walkway<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-700">Plank Models</span>
          </h1>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-medium">
            Pick any two of our walkway plank types to see them side by side.
          </p>
        </div>
      </div>
    </section>

    <!-- Comparator -->
    <section class="py-12 sm:py-16 bg-white border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-6 relative">

          <div class="hidden lg:flex absolute left-1/2 top-0 bottom-0 -translate-x-1/2 z-10 items-center">
            <span class="w-12 h-12 rounded-full bg-slate-900 text-white text-xs font-black flex items-center justify-center uppercase shadow-lg border-4 border-white">vs</span>
          </div>

          <!-- Column A -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 sm:p-8">
            <label for="modelA" class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Select Model A</label>
            <select id="modelA" class="w-full rounded-sm border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-900 uppercase tracking-wide focus:outline-none focus:ring-2 focus:ring-emerald-400 mb-6">
              <option value="fold2" selected>2-Fold Walkway Plank</option>
              <option value="fold3">3-Fold Walkway Plank</option>
              <option value="noHook">Walkway Plank Without Hook</option>
              <option value="cTypeHook">Walkway Plank With C-Type Hook</option>
              <option value="dogEarHook">Walkway Plank With Dog Ear Hook</option>
            </select>

            <div class="aspect-[4/3] bg-slate-200 rounded-lg overflow-hidden relative mb-6">
              <img id="modelAImg" src="" alt="" class="w-full h-full object-cover" />
              <span id="modelABadge" class="absolute top-3 left-3 px-2.5 py-1 bg-slate-900/80 text-white text-[9px] font-bold uppercase tracking-widest rounded-sm"></span>
            </div>

            <h3 id="modelAName" class="text-lg font-black text-slate-900 uppercase tracking-wide mb-2"></h3>
            <p id="modelATagline" class="text-xs text-slate-600 font-medium leading-relaxed"></p>
          </div>

          <!-- Column B -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 sm:p-8">
            <label for="modelB" class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Select Model B</label>
            <select id="modelB" class="w-full rounded-sm border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-900 uppercase tracking-wide focus:outline-none focus:ring-2 focus:ring-emerald-400 mb-6">
              <option value="fold2">2-Fold Walkway Plank</option>
              <option value="fold3">3-Fold Walkway Plank</option>
              <option value="noHook">Walkway Plank Without Hook</option>
              <option value="cTypeHook">Walkway Plank With C-Type Hook</option>
              <option value="dogEarHook" selected>Walkway Plank With Dog Ear Hook</option>
            </select>

            <div class="aspect-[4/3] bg-slate-200 rounded-lg overflow-hidden relative mb-6">
              <img id="modelBImg" src="" alt="" class="w-full h-full object-cover" />
              <span id="modelBBadge" class="absolute top-3 left-3 px-2.5 py-1 bg-slate-900/80 text-white text-[9px] font-bold uppercase tracking-widest rounded-sm"></span>
            </div>

            <h3 id="modelBName" class="text-lg font-black text-slate-900 uppercase tracking-wide mb-2"></h3>
            <p id="modelBTagline" class="text-xs text-slate-600 font-medium leading-relaxed"></p>
          </div>

        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="py-14 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 uppercase tracking-tight mb-4">Ready to <span class="text-emerald-600">Configure?</span></h2>
        <p class="text-slate-600 text-sm mb-8 max-w-xl mx-auto font-medium">Tell us your span length, load requirements, and mounting setup and we'll recommend the right plank.</p>
        <a href="/quote" class="inline-flex h-14 items-center justify-center rounded-sm bg-emerald-600 px-8 text-[12px] font-black text-white uppercase tracking-widest hover:bg-emerald-700 transition-all shadow-lg hover:shadow-xl active:scale-95">
          CONFIGURE & QUOTE
        </a>
      </div>
    </section>

  </main>
</Layout>

<script define:vars={{
  images: {
    fold2: fold2Img.src,
    fold3: fold3Img.src,
    noHook: noHookImg.src,
    cTypeHook: cTypeHookImg.src,
    dogEarHook: dogEarHookImg.src
  }
}}>
  const data = {
    fold2: {
      name: "2-Fold Walkway Plank",
      tier: "2-Fold",
      tagline: "Our standard double-fold plank, engineered for rigidity and reliable everyday performance on general scaffolding platforms."
    },
    fold3: {
      name: "3-Fold Walkway Plank",
      tier: "3-Fold",
      tagline: "A wider triple-fold profile that adds extra stiffness for longer spans and heavier industrial loads."
    },
    noHook: {
      name: "Walkway Plank Without Hook",
      tier: "Hookless",
      tagline: "A hookless format designed to rest flush on custom bearers and non-standard support frames."
    },
    cTypeHook: {
      name: "Walkway Plank With C-Type Hook",
      tier: "C-Type Hook",
      tagline: "Fitted with C-type hooks that seat directly onto ledger pipes for fast, tool-free installation."
    },
    dogEarHook: {
      name: "Walkway Plank With Dog Ear Hook",
      tier: "Dog Ear Hook",
      tagline: "Fitted with reinforced dog-ear hooks for extra lateral grip and maximum security on high-vibration, high-traffic sites."
    }
  };

  const selectA = document.getElementById("modelA");
  const selectB = document.getElementById("modelB");

  function fillColumn(key, prefix) {
    const model = data[key];
    document.getElementById(prefix + "Img").src = images[key];
    document.getElementById(prefix + "Img").alt = model.name;
    document.getElementById(prefix + "Badge").textContent = model.tier;
    document.getElementById(prefix + "Name").textContent = model.name;
    document.getElementById(prefix + "Tagline").textContent = model.tagline;
  }

  function render() {
    fillColumn(selectA.value, "modelA");
    fillColumn(selectB.value, "modelB");
  }

  selectA.addEventListener("change", render);
  selectB.addEventListener("change", render);
  render();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
  .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }
</style>
---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// ==========================================
// CUSTOM ASSET IMPORTS
// ==========================================
// 1. System Architecture Assets
import cuplockImg from '../../assets/staircase/(updated)Staircase Tower Cuplock Component.jpg';
import handrailImg from '../../assets/staircase/(updated)Staircase Tower Handrail.jpg';
import landingImg from '../../assets/staircase/(updated) Staircase Tower resting landing.jpg';
import stepArmImg from '../../assets/staircase/(updated) Staircase Tower step arm.jpg'; // <-- ADDED STEP ARM

// 2. Extreme Environments Assets
import deepPitsImg from '../../assets/staircase/(updated)Staircase Tower Deep Pits & Excavations.jpg';
import bulletTrainImg from '../../assets/staircase/(updated)Staircase Tower Bullet Train & Metrorail.jpg';
import plantMaintImg from '../../assets/staircase/(updated)Staircase Tower Plant & refinery Maintenance.jpg';
import btmimg1 from '../../assets/staircase/walkway plank (1).jpg';
import btmimg2 from '../../assets/staircase/ringlock.png';
import btmimg3 from '../../assets/products/(updated) Staircase Tower with clean background.jpg';

// 3. Our Models Section Assets
// TODO: Replace these placeholder imports with your actual model photography
import modelEconomyImg from '../../assets/products/(updated) Staircase Tower with clean background.jpg';
import modelEconomyPlusImg from '../../assets/staircase/(updated)Staircase Tower Cuplock Component.jpg';
import modelAlphaImg from '../../assets/staircase/(updated)Staircase Tower Handrail.jpg';
import modelApexImg from '../../assets/staircase/(updated) Staircase Tower resting landing.jpg';

---

<Layout title="Heavy-Duty Staircase Towers India | Vertex by Primesteeltech">
  
  <script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "Heavy-Duty Scaffolding Staircase Tower",
  "image": "https://www.yourdomain.com/assets/staircase-tower.jpg",
  "description": "OSHA-compliant modular staircase tower with anti-slip resting landings, engineered for high-capacity industrial worker egress.",
  "brand": {
    "@type": "Brand",
    "name": "Vertex by Primesteeltech"
  },
  "material": "Hot-Dip Galvanized Steel",
  "offers": {
    "@type": "AggregateOffer",
    "availability": "https://schema.org/InStock",
    "offerCount": "1",
    "priceCurrency": "INR"
  }
}
</script>

  <main class="bg-slate-50 min-h-screen pt-20 md:pt-24 pb-16 overflow-x-hidden">
    
    <section class="pb-16 sm:pb-24 border-b border-slate-200 relative">
      <div class="absolute top-0 right-0 w-[300px] h-[300px] md:w-[600px] md:h-[600px] bg-emerald-100/60 blur-[100px] md:blur-[150px] rounded-full pointer-events-none"></div>
      <div class="absolute top-40 left-0 w-[200px] h-[200px] md:w-[400px] md:h-[400px] bg-teal-100/40 blur-[80px] md:blur-[120px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <nav class="mb-6 flex items-center justify-between flex-wrap gap-4">
          <div class="flex text-[10px] font-bold text-slate-400 uppercase tracking-widest">
            <a href="/products" class="hover:text-emerald-600 transition-colors">Products</a>
            <span class="mx-2">/</span>
            <span class="text-emerald-600">Staircase Towers</span>
          </div>

          <a href="/products/compare-staircase-towers" class="group relative inline-flex items-center gap-2.5 rounded-full bg-gradient-to-r from-emerald-600 to-teal-600 px-6 py-3 text-[12px] font-black text-white uppercase tracking-widest shadow-[0_4px_20px_rgba(16,185,129,0.45)] ring-2 ring-emerald-300/60 ring-offset-2 ring-offset-slate-50 hover:shadow-[0_6px_28px_rgba(16,185,129,0.6)] hover:scale-[1.04] transition-all duration-300 animate-pulse-slow">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>
            Compare Our Models
            <svg class="h-4 w-4 group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <div class="lg:col-span-5 relative z-20">
            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-[11px] font-semibold text-emerald-600 uppercase tracking-widest mb-6 shadow-sm">
              <span class="flex h-2 w-2 shrink-0 rounded-full bg-emerald-400 animate-pulse"></span>
              High-Capacity Worker Egress
            </div>
            
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 uppercase tracking-tight mb-6 leading-[1.1]">
              Heavy-Duty Scaffolding<br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-700">Staircase Towers</span>
            </h1>
            
            <p class="font-jakarta text-slate-600 text-sm sm:text-base leading-relaxed mb-8">
              Engineered for safe, rapid vertical transit. Our modular staircase towers eliminate the dangers of vertical ladder climbing. Built seamlessly into our scaffolding matrices, they support high-density worker movement and heavy tool transport simultaneously.
            </p>

            <div class="flex flex-wrap gap-3 mb-10">
              <span class="px-3 py-1.5 bg-white border border-emerald-200 text-emerald-600 text-[10px] font-bold uppercase tracking-widest rounded-sm flex items-center gap-2 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> OSHA Fall Protected
              </span>
            </div>

            <div class="flex flex-col sm:flex-row items-center gap-4 mt-8">
              <a href="/quote" class="w-full sm:w-auto inline-flex h-12 items-center justify-center rounded-[3px] bg-emerald-600 px-8 text-[13px] font-bold text-white uppercase tracking-widest hover:bg-emerald-500 transition-colors shadow-lg">
                CONFIGURE & QUOTE
              </a>
              
              <a href="/pdfs/staircase-specs.pdf" download class="group w-full sm:w-auto inline-flex h-12 items-center justify-center gap-2 rounded-[3px] border border-slate-200 bg-transparent px-8 text-[13px] font-bold text-slate-600 uppercase tracking-widest hover:border-emerald-400 hover:bg-emerald-50 hover:text-emerald-600 transition-colors">
                <svg class="h-4 w-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                DOWNLOAD SPECS
              </a>
            </div>
          </div>

          <div class="lg:col-span-7 relative z-10 w-full aspect-square md:h-[500px] md:aspect-auto mt-8 lg:mt-0">
            <div class="w-full h-full rounded-sm border border-slate-200 overflow-hidden relative shadow-lg">
              <Image src={btmimg3} alt="Ringlock Rosette Component" class="w-full h-full object-cover" />
            </div>
            <p class="font-jakarta text-center text-xs sm:text-sm font-bold uppercase tracking-[0.2em] text-slate-500 mt-4">
              Flagship System &mdash; <span class="text-emerald-600">Apex Model</span>
            </p>
          </div>

        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24 bg-white border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight">Our <span class="text-emerald-600">Models</span></h2>
          <div class="h-1 w-12 bg-emerald-400 mx-auto mt-4 rounded-full mb-6"></div>
          <p class="font-jakarta text-slate-600 text-sm leading-relaxed mb-8">
            Four configurations engineered for every budget and site demand, from short-term access to permanent high-rise egress.
          </p>
          <a href="/products/compare-staircase-towers" class="group relative inline-flex items-center gap-2.5 rounded-full bg-gradient-to-r from-emerald-600 to-teal-600 px-6 py-3 text-[12px] font-black text-white uppercase tracking-widest shadow-[0_4px_20px_rgba(16,185,129,0.45)] ring-2 ring-emerald-300/60 ring-offset-2 ring-offset-white hover:shadow-[0_6px_28px_rgba(16,185,129,0.6)] hover:scale-[1.04] transition-all duration-300 animate-pulse-slow">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>
            Compare Our Models
            <svg class="h-4 w-4 group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

          <div class="bg-slate-50 border border-slate-200 rounded-sm p-6 hover:border-emerald-400 hover:shadow-sm transition-all duration-300 group hover:-translate-y-1 flex flex-col h-full">
            <div class="aspect-[3/4] bg-slate-200 rounded-sm mb-6 overflow-hidden relative border border-slate-200">
              <Image src={modelEconomyImg} alt="Economy Staircase Tower Model" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-110 group-hover:opacity-100 transition-all duration-500" />
            </div>
            <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wide mb-2">Economy</h3>
            <p class="font-jakarta text-xs text-slate-600 leading-relaxed mb-4 flex-grow">A no-frills, cost-efficient staircase tower built for short-duration projects. Delivers safe, code-compliant vertical access without added specification overhead.</p>
            <a href="/blogs/economy-staircase-tower" class="inline-flex items-center gap-1.5 text-[11px] font-bold text-emerald-600 uppercase tracking-widest hover:text-emerald-500 transition-colors mt-auto">
              More Information
              <svg class="h-3 w-3 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded-sm p-6 hover:border-emerald-400 hover:shadow-sm transition-all duration-300 group hover:-translate-y-1 flex flex-col h-full">
            <div class="aspect-[3/4] bg-slate-200 rounded-sm mb-6 overflow-hidden relative border border-slate-200">
              <Image src={modelEconomyPlusImg} alt="Economy Plus Staircase Tower Model" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-110 group-hover:opacity-100 transition-all duration-500" />
            </div>
            <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wide mb-2">Alpha</h3>
            <p class="font-jakarta text-xs text-slate-600 leading-relaxed mb-4 flex-grow">Builds on the Economy base with reinforced stringers and wider treads, suited to medium-duration projects with higher worker traffic.</p>
            <a href="/blogs/economy-plus-staircase-tower" class="inline-flex items-center gap-1.5 text-[11px] font-bold text-emerald-600 uppercase tracking-widest hover:text-emerald-500 transition-colors mt-auto">
              More Information
              <svg class="h-3 w-3 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded-sm p-6 hover:border-emerald-400 hover:shadow-sm transition-all duration-300 group hover:-translate-y-1 flex flex-col h-full">
            <div class="aspect-[3/4] bg-slate-200 rounded-sm mb-6 overflow-hidden relative border border-slate-200">
              <Image src={modelAlphaImg} alt="Alpha Staircase Tower Model" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-110 group-hover:opacity-100 transition-all duration-500" />
            </div>
            <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wide mb-2">Premium</h3>
            <p class="font-jakarta text-xs text-slate-600 leading-relaxed mb-4 flex-grow">Our high-capacity mid-tier tower, engineered with heavier-gauge steel and enclosed handrails for continuous industrial and infrastructure use.</p>
            <a href="/blogs/alpha-staircase-tower" class="inline-flex items-center gap-1.5 text-[11px] font-bold text-emerald-600 uppercase tracking-widest hover:text-emerald-500 transition-colors mt-auto">
              More Information
              <svg class="h-3 w-3 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>

          <div class="bg-slate-50 border border-emerald-300 rounded-sm p-6 hover:border-emerald-400 hover:shadow-md transition-all duration-300 group hover:-translate-y-1 flex flex-col h-full relative">
            <span class="absolute -top-3 left-6 px-3 py-1 bg-emerald-600 text-white text-[9px] font-bold uppercase tracking-widest rounded-sm shadow-sm">Flagship</span>
            <div class="aspect-[3/4] bg-slate-200 rounded-sm mb-6 overflow-hidden relative border border-slate-200">
              <Image src={modelApexImg} alt="Apex Staircase Tower Model" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-110 group-hover:opacity-100 transition-all duration-500" />
            </div>
            <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wide mb-2">Apex</h3>
            <p class="font-jakarta text-xs text-slate-600 leading-relaxed mb-4 flex-grow">Our top-of-line system for 60+ storey high-rises and extreme sites, built to peak tread capacity with full OSHA/BS EN handrail enclosure.</p>
            <a href="/blogs/apex-staircase-tower" class="inline-flex items-center gap-1.5 text-[11px] font-bold text-emerald-600 uppercase tracking-widest hover:text-emerald-500 transition-colors mt-auto">
              More Information
              <svg class="h-3 w-3 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>

        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24 bg-white border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight">System <span class="text-emerald-600">Architecture</span></h2>
          <div class="h-1 w-12 bg-emerald-400 mx-auto mt-4 rounded-full mb-6"></div>
          <p class="font-jakarta text-slate-600 text-sm leading-relaxed">
            Eliminate vertical fatigue and ladder risks. Our staircase towers are wide, solid, and built exactly to OSHA egress standards.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <div class="bg-slate-50 border border-slate-200 rounded-sm p-6 hover:border-emerald-400 hover:shadow-sm transition-all duration-300 group hover:-translate-y-1 flex flex-col h-full">
            <div class="aspect-square bg-slate-200 rounded-sm mb-6 overflow-hidden relative border border-slate-200">
              <Image src={cuplockImg} alt="Cuplock Component" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-110 group-hover:opacity-100 transition-all duration-500" />
            </div>
            <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wide mb-2">Interlocking Architecture</h3>
            <p class="font-jakarta text-xs text-slate-600 leading-relaxed">Heavy-duty structural components that drop directly onto standard ledgers, forming the unyielding base of the stairs.</p>
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded-sm p-6 hover:border-emerald-400 hover:shadow-sm transition-all duration-300 group hover:-translate-y-1 flex flex-col h-full">
            <div class="aspect-square bg-slate-200 rounded-sm mb-6 overflow-hidden relative border border-slate-200">
              <Image src={handrailImg} alt="Safety Handrails" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-110 group-hover:opacity-100 transition-all duration-500" />
            </div>
            <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wide mb-2">Safety Handrails</h3>
            <p class="font-jakarta text-xs text-slate-600 leading-relaxed">Continuous tubular guards that lock into the outer rosettes, completely enclosing the staircase to prevent fall hazards.</p>
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded-sm p-6 hover:border-emerald-400 hover:shadow-sm transition-all duration-300 group hover:-translate-y-1 flex flex-col h-full">
            <div class="aspect-square bg-slate-200 rounded-sm mb-6 overflow-hidden relative border border-slate-200">
              <Image src={landingImg} alt="Resting Landings" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-110 group-hover:opacity-100 transition-all duration-500" />
            </div>
            <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wide mb-2">Resting Landings</h3>
            <p class="font-jakarta text-xs text-slate-600 leading-relaxed">Wide, flat platforms situated between stair flights, allowing workers to rest or safely maneuver heavy equipment.</p>
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded-sm p-6 hover:border-emerald-400 hover:shadow-sm transition-all duration-300 group hover:-translate-y-1 flex flex-col h-full">
            <div class="aspect-square bg-slate-200 rounded-sm mb-6 overflow-hidden relative border border-slate-200">
              <Image src={stepArmImg} alt="Step Arm Component" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-110 group-hover:opacity-100 transition-all duration-500" />
            </div>
            <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wide mb-2">Heavy-Duty Step Arms</h3>
            <p class="font-jakarta text-xs text-slate-600 leading-relaxed">Robust structural brackets that securely lock into the vertical standards, providing unyielding support for the anti-slip stair treads.</p>
          </div>

        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24 bg-slate-50 border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight">Engineered for <span class="text-emerald-600">Extreme Environments</span></h2>
          <div class="h-1 w-12 bg-emerald-400 mx-auto mt-4 rounded-full mb-6"></div>
          <p class="font-jakarta text-slate-600 text-sm leading-relaxed">
            Wherever continuous, high-volume worker access is required, Vertex staircase towers provide a permanent-feeling solution in a temporary structure.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <div class="group relative aspect-square sm:aspect-[4/5] overflow-hidden rounded-sm border border-slate-200 bg-slate-200">
            <Image src={deepPitsImg} alt="Deep Excavation Access" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-110 transition-all duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <h3 class="text-lg font-bold text-white uppercase tracking-wide mb-2 group-hover:text-emerald-600 transition-colors">Deep Pits & Excavation</h3>
              <p class="font-jakarta text-xs text-slate-600 leading-relaxed">Provides safe, low-angle descent into deep foundation pits where traditional ladders pose severe slip risks.</p>
            </div>
          </div>

          <div class="group relative aspect-square sm:aspect-[4/5] overflow-hidden rounded-sm border border-slate-200 bg-slate-200">
            <Image src={bulletTrainImg} alt="Bullet Train & Metrorail Projects" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-110 transition-all duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <h3 class="text-lg font-bold text-white uppercase tracking-wide mb-2 group-hover:text-emerald-600 transition-colors">Bullet Train & Metrorail</h3>
              <p class="font-jakarta text-xs text-slate-600 leading-relaxed">Provides continuous, high-volume structural access for massive elevated transit and railway projects.</p>
            </div>
          </div>

          <div class="group relative aspect-square sm:aspect-[4/5] overflow-hidden rounded-sm border border-slate-200 bg-slate-200">
            <Image src={plantMaintImg} alt="Industrial Plant Maintenance" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-110 transition-all duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <h3 class="text-lg font-bold text-white uppercase tracking-wide mb-2 group-hover:text-emerald-600 transition-colors">Plant & Refinery Maintenance</h3>
              <p class="font-jakarta text-xs text-slate-600 leading-relaxed">Wide stair treads allow engineers to safely carry heavy diagnostic tools and parts up to operational pipeline levels.</p>
            </div>
          </div>
          
        </div>
      </div>
    </section>
        
        <section class="py-16 sm:py-24 border-b border-slate-200 relative bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
        
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 uppercase tracking-tight mb-6">
          See It. <span class="text-emerald-600">In Action .</span>
        </h2>
        
        <div class="space-y-6 text-slate-600 text-sm sm:text-base leading-relaxed max-w-3xl mb-12 font-medium">
          <p class="font-jakarta">
            The Prime Steeltech India Scaffolding Staircase Tower is a safe, durable, and efficient vertical access solution designed for demanding construction, industrial and infrastructure projects. Engineered to integrate seamlessly with both Cuplock and Ringlock scaffolding systems, it provides secure access for workers while improving productivity and site safety.
          </p>
        </div>

        <div class="relative w-full max-w-4xl aspect-video rounded-sm overflow-hidden shadow-2xl border border-emerald-200 bg-black">
          <iframe 
            class="absolute top-0 left-0 w-full h-full border-0"
            src="https://www.youtube.com/embed/2MGV248BzcA" 
            title="Prime SteelTech Manufacturing Process" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy">

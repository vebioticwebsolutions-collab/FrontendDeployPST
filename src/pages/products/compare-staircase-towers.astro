---
import Layout from '../../layouts/Layout.astro';

// ==========================================
// CUSTOM ASSET IMPORTS (placeholders — swap for dedicated model photography)
// ==========================================
import economyImg from '../../assets/staircase/economy blue.jpg';
import economyPlus4Img from '../../assets/staircase/new alpha 4 leg.jpg';
import economyPlus8Img from '../../assets/staircase/alpha blue 8 leg.jpg';
import alpha4Img from '../../assets/staircase/new premium 4 leg.jpg';
import alpha8Img from '../../assets/staircase/new premium 8 leg.jpg';
import apexImg from '../../assets/staircase/mini apex tower orange.jpg';
---

<Layout title="Compare Staircase Tower Models | Vertex by Primesteeltech">

  <main class="bg-slate-50 min-h-screen pt-20 md:pt-24 pb-16 overflow-x-hidden">

    <!-- Hero / Header -->
    <section class="pb-12 sm:pb-16 border-b border-slate-200 relative">
      <div class="absolute top-0 right-0 w-[300px] h-[300px] md:w-[600px] md:h-[600px] bg-emerald-100/60 blur-[100px] md:blur-[150px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <nav class="mb-6 flex items-center justify-between flex-wrap gap-4">
          <div class="flex text-[10px] font-bold text-slate-400 uppercase tracking-widest">
            <a href="/products" class="hover:text-emerald-600 transition-colors">Products</a>
            <span class="mx-2">/</span>
            <a href="/products/staircase-tower" class="hover:text-emerald-600 transition-colors">Staircase Towers</a>
            <span class="mx-2">/</span>
            <span class="text-emerald-600">Compare</span>
          </div>

          <a href="/products/staircase-tower" class="inline-flex items-center gap-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest hover:text-emerald-600 transition-colors">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Back to Staircase Towers
          </a>
        </nav>

        <div class="max-w-3xl">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 uppercase tracking-tight mb-4 leading-[1.1]">
            Compare Staircase<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-700">Tower Models</span>
          </h1>
          <p class="font-jakarta text-slate-600 text-sm sm:text-base leading-relaxed">
            Pick any two configurations to see specifications side by side, from the entry-level Economy system to the flagship Apex tower.
          </p>
        </div>
      </div>
    </section>

    <!-- Comparator -->
    <section class="py-12 sm:py-16 bg-white border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-6 relative">

          <div class="hidden lg:flex absolute left-1/2 top-0 bottom-0 -translate-x-1/2 z-10 items-center">
            <span class="w-12 h-12 rounded-full bg-slate-900 text-white text-xs font-black flex items-center justify-center uppercase shadow-lg border-4 border-white">vs</span>
          </div>

          <!-- Column A -->
          <div class="bg-slate-50 border border-slate-200 rounded-sm p-6 sm:p-8">
            <label for="modelA" class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Select Model A</label>
            <select id="modelA" class="w-full rounded-sm border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-900 uppercase tracking-wide focus:outline-none focus:ring-2 focus:ring-emerald-400 mb-6">
              <option value="economy">Economy</option>
              <option value="economyPlus4" selected>Alpha 4 Leg</option>
              <option value="economyPlus8">Alpha 8 Leg</option>
              <option value="alpha4">Premium 4 Leg</option>
              <option value="alpha8">Premium 8 Leg</option>
              <option value="apex">Apex</option>
            </select>

            <div class="aspect-[4/3] bg-slate-200 rounded-sm overflow-hidden relative border border-slate-200 mb-6">
              <img id="modelAImg" src="" alt="" class="w-full h-full object-cover" />
              <span id="modelABadge" class="absolute top-3 left-3 px-2.5 py-1 bg-emerald-600 text-white text-[9px] font-bold uppercase tracking-widest rounded-sm"></span>
            </div>

            <h3 id="modelAName" class="text-lg font-black text-slate-900 uppercase tracking-wide mb-2"></h3>
            <p id="modelATagline" class="font-jakarta text-xs text-slate-600 leading-relaxed"></p>
          </div>

          <!-- Column B -->
          <div class="bg-slate-50 border border-slate-200 rounded-sm p-6 sm:p-8">
            <label for="modelB" class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2">Select Model B</label>
            <select id="modelB" class="w-full rounded-sm border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-900 uppercase tracking-wide focus:outline-none focus:ring-2 focus:ring-emerald-400 mb-6">
              <option value="economy">Economy</option>
              <option value="economyPlus4">Alpha4 Leg</option>
              <option value="economyPlus8">Alpha 8 Leg</option>
              <option value="alpha4">Premium 4 Leg</option>
              <option value="alpha8">Premium 8 Leg</option>
              <option value="apex" selected>Apex</option>
            </select>

            <div class="aspect-[4/3] bg-slate-200 rounded-sm overflow-hidden relative border border-slate-200 mb-6">
              <img id="modelBImg" src="" alt="" class="w-full h-full object-cover" />
              <span id="modelBBadge" class="absolute top-3 left-3 px-2.5 py-1 bg-emerald-600 text-white text-[9px] font-bold uppercase tracking-widest rounded-sm"></span>
            </div>

            <h3 id="modelBName" class="text-lg font-black text-slate-900 uppercase tracking-wide mb-2"></h3>
            <p id="modelBTagline" class="font-jakarta text-xs text-slate-600 leading-relaxed"></p>
          </div>

        </div>

        <!-- Spec Table (continues directly below the picture columns) -->
        <div class="mt-12 sm:mt-16 max-w-5xl mx-auto">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 uppercase tracking-tight mb-8">Specification <span class="text-emerald-600">Comparison</span></h2>

          <div class="w-full overflow-x-auto rounded-sm border border-emerald-200 bg-white shadow-2xl">
            <table class="w-full text-left font-jakarta text-sm">
              <thead class="bg-emerald-100/60 text-emerald-600 border-b border-emerald-200">
                <tr>
                  <th class="px-6 py-4 font-bold uppercase tracking-wider text-xs">Parameter</th>
                  <th id="theadA" class="px-6 py-4 font-bold uppercase tracking-wider text-xs">Model A</th>
                  <th id="theadB" class="px-6 py-4 font-bold uppercase tracking-wider text-xs">Model B</th>
                </tr>
              </thead>
              <tbody id="specBody" class="divide-y divide-slate-100 text-slate-600">
                <!-- rows injected by script -->
              </tbody>
            </table>
          </div>

          <p class="font-jakarta text-xs text-slate-400 mt-4">Bold values indicate a difference between the two selected models.</p>
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section class="py-14 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 uppercase tracking-tight mb-4">Ready to <span class="text-emerald-600">Configure?</span></h2>
        <p class="font-jakarta text-slate-600 text-sm mb-8 max-w-xl mx-auto">Tell us your project height, worker traffic, and site conditions and we'll recommend the right model.</p>
        <a href="/quote" class="inline-flex h-12 items-center justify-center rounded-[3px] bg-emerald-600 px-8 text-[13px] font-bold text-white uppercase tracking-widest hover:bg-emerald-500 transition-colors shadow-lg">
          CONFIGURE & QUOTE
        </a>
      </div>
    </section>

  </main>
</Layout>

<script define:vars={{
  images: {
    economy: economyImg.src,
    economyPlus4: economyPlus4Img.src,
    economyPlus8: economyPlus8Img.src,
    alpha4: alpha4Img.src,
    alpha8: alpha8Img.src,
    apex: apexImg.src
  }
}}>
  const data = {
    economy: {
      name: "Economy",
      tier: "Budget",
      tagline: "Prime Steeltech's value-engineered cuplock tower with open square-pipe grating on stairs and landings, built for fast, cost-controlled deployments where water and debris need to drain straight through.",
      specs: {
        "Leg Configuration": "4-Leg Cuplock",
        "Grid Size (L \u00d7 W)": "2,000 \u00d7 1,500 mm",
        "Platform Height (Max)": "Multiples of 1.5m / 3m",
        "Stair Width (Clear)": "600 mm",
        "Tread / Stair Surface": "M.S. Square Pipe Grating, 25\u00d725mm (open-mesh)",
        "Side Rail / Guard Rail": "Not fitted \u2014 economy configuration",
        "Staircase Angle": "54\u00b0",
        "Step Arm UDL (Design Load)": "250 kg/m\u00b2",
        "Toe Guards": "Not fitted \u2014 economy configuration",
        "Ideal Use Case": "Basement excavation & short-duration access",
        "Price Positioning": "Budget"
      }
    },
    economyPlus4: {
      name: "Alpha 4 Leg",
      tier: "Value",
      tagline: "A 4-leg cuplock tower with self-draining square-pipe grating and a welded socket joint, engineered for basement excavations and other drainage-critical sites.",
      specs: {
        "Leg Configuration": "4-Leg Cuplock",
        "Grid Size (L \u00d7 W)": "2,500 \u00d7 1,800 mm",
        "Platform Height (Max)": "Up to 60 m",
        "Stair Width (Clear)": "700 mm",
        "Tread / Stair Surface": "M.S. Square Pipe Grating, 25\u00d725mm (self-draining)",
        "Side Rail / Guard Rail": "940 mm / 470 mm (both sides)",
        "Staircase Angle": "49\u00b0",
        "Step Arm UDL (Design Load)": "250 kg/m\u00b2",
        "Toe Guards": "Not provided \u2014 economy configuration",
        "Ideal Use Case": "Basement & below-grade access, drainage-critical sites",
        "Price Positioning": "Value"
      }
    },
    economyPlus8: {
      name: "Alpha 8 Leg",
      tier: "Value+",
      tagline: "The 8-leg version of Alpha, adding extra footprint and stability for larger self-draining access requirements on wet or muddy sites.",
      specs: {
        "Leg Configuration": "8-Leg Cuplock",
        "Grid Size (L \u00d7 W)": "3,800 \u00d7 1,800 mm",
        "Platform Height (Max)": "Up to 60 m",
        "Stair Width (Clear)": "700 mm",
        "Tread / Stair Surface": "M.S. Square Pipe Grating, 25\u00d725mm (self-draining)",
        "Side Rail / Guard Rail": "940 mm / 470 mm (both sides)",
        "Staircase Angle": "41\u00b0",
        "Step Arm UDL (Design Load)": "450 kg/m\u00b2 (2.45 kN/m\u00b2)",
        "Toe Guards": "Not provided \u2014 economy configuration",
        "Ideal Use Case": "Wider self-draining access for larger sites",
        "Price Positioning": "Value+"
      }
    },
    alpha4: {
      name: "Premium 4 Leg",
      tier: "Performance",
      tagline: "Prime Steeltech's standard 4-leg staircase system with anti-skid dimple treads, full-height guard rails, and toe boards on every landing for reliable everyday site access.",
      specs: {
        "Leg Configuration": "4-Leg Cuplock / Ringlock",
        "Grid Size (L \u00d7 W)": "2,500 \u00d7 2,000 mm",
        "Platform Height (Max)": "Up to 60 m",
        "Stair Width (Clear)": "800 mm",
        "Tread / Stair Surface": "M.S. Sheet, Anti-Skid Dimple",
        "Side Rail / Guard Rail": "940 mm / 470 mm (both sides)",
        "Staircase Angle": "49\u00b0",
        "Step Arm UDL (Design Load)": "450 kg/m\u00b2",
        "Toe Guards": "3 sides \u00b7 150 mm",
        "Ideal Use Case": "High-rise, industrial & infrastructure projects",
        "Price Positioning": "Performance"
      }
    },
    alpha8: {
      name: "Premium 8 Leg",
      tier: "Performance+",
      tagline: "An 8-leg PREMIUM configuration spanning a wider grid, built for high-rise and infrastructure projects that need broader, higher-capacity access.",
      specs: {
        "Leg Configuration": "8-Leg Cuplock / Ringlock",
        "Grid Size (L \u00d7 W)": "2,000 \u00d7 3,800 mm",
        "Platform Height (Max)": "Up to 60 m",
        "Stair Width (Clear)": "800 mm",
        "Tread / Stair Surface": "M.S. Sheet, Anti-Skid Dimple",
        "Side Rail / Guard Rail": "940 mm / 470 mm (both sides)",
        "Staircase Angle": "41\u00b0",
        "Step Arm UDL (Design Load)": "450 kg/m\u00b2",
        "Toe Guards": "3 sides \u00b7 150 mm",
        "Ideal Use Case": "Wider, higher-capacity access for major sites",
        "Price Positioning": "Performance+"
      }
    },
    apex: {
      name: "Apex",
      tier: "Flagship",
      tagline: "Prime Steeltech's most premium tower, combining anti-skid checkered plate treads with full fall protection across a generous 8-leg frame for the most demanding high-rise and industrial sites.",
      specs: {
        "Leg Configuration": "8-Leg Cuplock",
        "Grid Size (L \u00d7 W)": "3,800 \u00d7 2,200 mm",
        "Platform Height (Max)": "Up to 60 m",
        "Stair Width (Clear)": "900 mm",
        "Tread / Stair Surface": "M.S. Checkered Plate, Anti-Skid (IS 3502)",
        "Side Rail / Guard Rail": "940 mm / 470 mm (both sides)",
        "Staircase Angle": "41\u00b0",
        "Step Arm UDL (Design Load)": "450 kg/m\u00b2",
        "Toe Guards": "3 sides \u00b7 150 mm",
        "Ideal Use Case": "Premium high-rise & extreme-duty sites",
        "Price Positioning": "Flagship"
      }
    }
  };

  const selectA = document.getElementById("modelA");
  const selectB = document.getElementById("modelB");
  const specBody = document.getElementById("specBody");

  function fillColumn(key, prefix) {
    const model = data[key];
    document.getElementById(prefix + "Img").src = images[key];
    document.getElementById(prefix + "Img").alt = model.name + " Staircase Tower";
    document.getElementById(prefix + "Badge").textContent = model.tier;
    document.getElementById(prefix + "Name").textContent = model.name;
    document.getElementById(prefix + "Tagline").textContent = model.tagline;
  }

  function render() {
    const keyA = selectA.value;
    const keyB = selectB.value;

    fillColumn(keyA, "modelA");
    fillColumn(keyB, "modelB");

    document.getElementById("theadA").textContent = data[keyA].name;
    document.getElementById("theadB").textContent = data[keyB].name;

    specBody.innerHTML = "";
    Object.keys(data[keyA].specs).forEach((label) => {
      const valA = data[keyA].specs[label];
      const valB = data[keyB].specs[label];
      const differs = valA !== valB;

      const tr = document.createElement("tr");
      tr.className = "hover:bg-emerald-50 transition-colors";

      const tdLabel = document.createElement("td");
      tdLabel.className = "px-6 py-4 font-semibold text-slate-900";
      tdLabel.textContent = label;

      const tdA = document.createElement("td");
      tdA.className = differs ? "px-6 py-4 font-bold text-emerald-700" : "px-6 py-4 text-slate-600";
      tdA.textContent = valA;

      const tdB = document.createElement("td");
      tdB.className = differs ? "px-6 py-4 font-bold text-emerald-700" : "px-6 py-4 text-slate-600";
      tdB.textContent = valB;

      tr.appendChild(tdLabel);
      tr.appendChild(tdA);
      tr.appendChild(tdB);
      specBody.appendChild(tr);
    });
  }

  selectA.addEventListener("change", render);
  selectB.addEventListener("change", render);
  render();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
  .font-jakarta { font-family: 'Plus Jakarta Sans', sans-serif; }
</style>
---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ringlockOpt1 from '../assets/products/Ringlock Option 1.jpeg';
import walkway from '../assets/walkway/walkway plank product image.jpg';
import staircase from '../assets/products/(updated) Staircase Tower with clean background.jpg';
import btmwalk from '../assets/home-page/walkway buyer guide image.jpg';
import btmtower from '../assets/home-page/staircase buyers guide image.jpg';
import btmring from '../assets/home-page/ringlock pic buyers guide.jpg';


 
// ==========================================
// IMAGE IMPORTS (Mapped to your exact file names)
// ==========================================
 
 //Carousel Background Images (Directly from products folder)

import bgImg1 from '../assets/home-page/ringlock product image new watermark.jpg';
import bgImg2 from '../assets/home-page/staircase product image new watermark.jpg';
import bgImg3 from '../assets/home-page/walkway plank product image new watermark.jpg';
 
// Section 3: Leading Manufacturers
import img3_1 from '../assets/home-page/Leading manufacturers section pic staircase tower.jpg'; 
import img3_2 from '../assets/home-page/Leading manufacturers section pic walkway plank.jpg';
 
// Section 4: Ringlock, Towers, Planks
import img4_1 from '../assets/home-page/(updated)4-1 (1).jpg';
import img4_2 from '../assets/home-page/(updated)4-2 (1).jpg';
import img4_3 from '../assets/home-page/(updated)4-3.png';
import img4_4 from '../assets/home-page/(updated)4-4 (1).jpg';
 
// Section 6: Sectors
import img6_1 from '../assets/home-page/(updated)6-1.jpg';
import img6_2 from '../assets/home-page/(updated)6-2.jpg';
import img6_3 from '../assets/home-page/(updated)6-3.jpg';
import img6_4 from '../assets/home-page/data center pic option 1.jpg'; 
 
// Section 8: Product Mini-Cards
import img8_1 from '../assets/home-page/Engineered for extreme loads pic walkway plank.jpg';
import img8_2 from '../assets/home-page/mini apex tower orange.jpg';
import img8_3 from '../assets/home-page/(updated)8-3.jpg';
 
// Logos
import logoAdani from '../assets/home-page/logo adani.png';
import logoLT from '../assets/home-page/logo L&T.png';
import logoTata from '../assets/home-page/logo tataprojects.jpeg';
import logoJKumar from '../assets/home-page/logo jkumar.png';

// ==========================================
// HOME PAGE SCHEMA (SEO/GEO)
// ==========================================
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Prime SteelTech India Pvt Ltd",
  "url": "https://primesteeltech.com/",
  "description": "Best manufacturer of Anti skid walkway planks, GI boards, scaffolding staircase towers, and Ringlock scaffolding, Cuplock Scaffolding and steel props in Mumbai and MMRDA region, India."
};
---
 
<Layout title="Prime SteelTech India Pvt Ltd | Top Scaffolding Manufacturer Mumbai">
  
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
 
  <main class="bg-slate-50 text-slate-900 overflow-hidden font-jakarta">
    
    <section class="relative pt-24 pb-20 sm:pt-32 sm:pb-32 border-b border-slate-200 text-center z-10 flex flex-col justify-center min-h-[85vh] sm:min-h-[90vh]">
      
      <!-- Carousel background: kept fully visible, no heavy overlay blocking it -->
      <div class="absolute inset-0 z-0 overflow-hidden bg-slate-50">
        <img src={bgImg1.src} alt="Ringlock Systems" class="absolute inset-0 w-full h-full object-cover opacity-0 animate-fade-1 z-0" />
        <img src={bgImg2.src} alt="Staircase Towers" class="absolute inset-0 w-full h-full object-cover opacity-0 animate-fade-2 z-0" />
        <img src={bgImg3.src} alt="Walkway Planks" class="absolute inset-0 w-full h-full object-cover opacity-0 animate-fade-3 z-0" />
 
        <!-- Very light scrim only, just enough to keep badges/edges legible; the real contrast now comes from the glass panel around the text -->
        <div class="absolute inset-0 bg-slate-900/5"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-slate-50/50 via-transparent to-slate-50/60 z-10"></div>
      </div>
 
      <div class="relative z-20 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col items-center">
 
        <!-- READABILITY PANEL: frosted glass card that separates text from the moving carousel behind it, while the carousel stays fully visible outside the card edges -->
        <div class="w-full rounded-2xl bg-white/15 backdrop-blur-sm border border-white/70 shadow-[0_25px_70px_rgba(15,23,42,0.18)] px-5 py-10 sm:px-12 sm:py-14 flex flex-col items-center">
 
<div class="flex flex-wrap justify-center gap-3 mb-8">
            <div class="inline-flex items-center gap-2 rounded-full ring-2 ring-emerald-300/60 bg-gradient-to-r from-emerald-500 to-teal-500 px-5 py-2.5 text-[10px] sm:text-xs font-bold text-white uppercase tracking-widest shadow-[0_8px_30px_rgba(16,185,129,0.5)] hover:shadow-[0_8px_36px_rgba(16,185,129,0.7)] hover:scale-105 transition-all duration-300">
              <span class="relative flex h-2.5 w-2.5 shrink-0">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
              </span>
              <span>26+ Years of Industry Trust</span>
            </div>
            <div class="hidden sm:inline-flex items-center gap-2 rounded-full ring-2 ring-slate-700/40 bg-slate-900 px-5 py-2.5 text-[10px] font-bold text-white uppercase tracking-widest shadow-[0_8px_30px_rgba(15,23,42,0.5)] hover:shadow-[0_8px_36px_rgba(15,23,42,0.7)] hover:scale-105 transition-all duration-300">
              <svg class="h-3.5 w-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              BS/EN/OSHA/IS Compliant
            </div>
          </div>
 
          <h1 class="flex flex-col items-center justify-center space-y-3 sm:space-y-4 max-w-5xl">
            <span class="text-4xl sm:text-5xl lg:text-7xl font-black text-slate-900 uppercase tracking-tight leading-[1.1] sm:leading-[1.1]">
              Best In Class Scaffolding Manufacturers in India
            </span>
            <span class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-700 uppercase tracking-tight leading-snug">
              Anti Skid Walkway Planks <span class="text-slate-300 mx-2 hidden sm:inline">&bull;</span><br class="block sm:hidden" /> Scaffolding Staircase Towers <br class ="block sm:hidden" /> Modular Ringlock Systems
            </span>
          </h1>
 
          <div class="mt-8 flex flex-col items-center space-y-4 max-w-4xl">
            <p class="text-sm sm:text-base lg:text-lg text-slate-700 leading-relaxed text-center font-medium">
              Engineered for India's toughest projects, Prime SteelTech India Pvt Ltd provides EN/BS/OSHO/BIS certified Ringlock & Cuplock Systems, GI Planks, Scaffolding Staircase Towers and other Modular Scaffolding Systems & Formworks.
            </p>
            <p class="text-xs sm:text-sm lg:text-base text-slate-500 leading-relaxed text-center max-w-3xl">
              With decades of expertise serving in India, Gulf and African countries, our systems ensure rock-solid stability and safety for diverse infrastructure and industrial projects. We also assist you throughout the project by providing services such as consultancy, personalization, erection & estimation of materials required for your project.
            </p>
          </div>
 
          <div class="mt-10 sm:mt-12 flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
            <a href="/quote" onclick="gtag('event', 'click_quote', {'location': 'hero'});" class="relative group w-full sm:w-auto inline-flex h-14 min-w-[220px] items-center justify-center rounded-sm bg-emerald-600 px-8 text-sm font-extrabold text-white shadow-lg hover:shadow-xl hover:bg-emerald-500 active:scale-[0.98] transition-all duration-300 uppercase tracking-widest z-10">
              <span class="relative z-20">Get a Quote</span>
            </a>
            <a href="/products" onclick="gtag('event', 'click_view_products', {'location': 'hero'});" class="w-full sm:w-auto inline-flex h-14 min-w-[220px] items-center justify-center rounded-sm border-2 border-emerald-600 bg-white/60 backdrop-blur-md px-8 text-sm font-bold text-emerald-700 hover:text-white hover:bg-emerald-600 active:bg-emerald-700 transition-all duration-300 uppercase tracking-widest shadow-sm">
              View Products
            </a>
          </div>
 
        </div>
        <!-- END READABILITY PANEL -->
 
      </div>
    </section>
 
    <section class="py-16 sm:py-24 border-b border-slate-200 relative bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
        
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mb-6">
          Elite Heritage. <span class="text-emerald-600">New Frontier.</span>
        </h2>
        
        <div class="space-y-6 text-slate-600 text-sm sm:text-base leading-relaxed max-w-3xl mb-12 font-medium text-justify">
          <p>
            Prime SteelTech India is redefining the industry through a next-generation digital platform. This combines instant quoting and real-time specifications with faster procurement, merging engineering heritage with digital efficiency
          </p>
        </div>
 
        <div class="relative w-full max-w-4xl aspect-video rounded-md overflow-hidden shadow-2xl border border-slate-200 bg-black">
          <iframe 
            class="absolute top-0 left-0 w-full h-full border-0"
            src="https://www.youtube.com/embed/OBa_5lMDzVA?autoplay=0&rel=0" 
            title="Prime SteelTech Manufacturing Process" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
            loading="lazy">
          </iframe>
        </div>
        <p class="mt-4 text-xs text-emerald-600 uppercase tracking-widest font-bold">Watch our manufacturing process in action</p>
 
      </div>
    </section>
 
    <section class="py-16 sm:py-24 border-b border-slate-200 relative overflow-hidden bg-slate-50">
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">
          
          <div class="flex flex-col bg-white border border-slate-200 rounded-lg p-8 sm:p-12 shadow-sm relative overflow-hidden group">
            <div class="relative z-10 flex-grow text-center lg:text-left">
              <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mb-4">
                Engineered for <br class="hidden lg:block"/><span class="text-emerald-600">Extreme Loads</span>
              </h2>
              <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-8 max-w-lg mx-auto lg:mx-0">
                Deep dive into our modular ringlock architecture, high-tensile steel planks, and heavy-duty robust industrial staircase systems.
              </p>
              
              <a href="/contact-us" onclick="gtag('event', 'click_contact', {'location': 'extreme_loads_section'});" class="inline-flex items-center gap-2 text-emerald-700 font-bold text-sm uppercase tracking-widest hover:text-emerald-800 transition-colors mb-10 border-b-2 border-emerald-500 pb-1">
                Discuss Your Project Specifications &rarr;
              </a>
              
              <div class="grid grid-cols-3 gap-3 mb-8 max-w-md mx-auto lg:mx-0">
                <a href="/products/walkway-planks" onclick="gtag('event', 'click_product_card', {'location': 'extreme_loads_section', 'product': 'walkway-planks'});" class="bg-slate-100 rounded-sm aspect-square relative border border-slate-200 hover:border-emerald-500 transition-colors flex items-end p-2 sm:p-3 shadow-inner group/card cursor-pointer overflow-hidden">
                  <span class="text-[9px] sm:text-[10px] font-bold text-white uppercase tracking-wider relative z-20 group-hover/card:text-emerald-400 transition-colors drop-shadow-md">Walkway Planks</span>
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/40 to-transparent z-10"></div>
                  <Image src={img8_1} class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover/card:scale-110 transition-all duration-500" alt="Planks" />
                </a>
                <a href="/products/staircase-tower" onclick="gtag('event', 'click_product_card', {'location': 'extreme_loads_section', 'product': 'staircase-tower'});" class="bg-slate-100 rounded-sm aspect-square relative border border-slate-200 hover:border-emerald-500 transition-colors flex items-end p-2 sm:p-3 shadow-inner group/card cursor-pointer overflow-hidden">
                  <span class="text-[9px] sm:text-[10px] font-bold text-white uppercase tracking-wider relative z-20 group-hover/card:text-emerald-400 transition-colors drop-shadow-md">Staircase Towers</span>
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/40 to-transparent z-10"></div>
                  <Image src={img8_2} class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover/card:scale-110 transition-all duration-500" alt="Towers" />
                </a>
                <a href="/products/ringlock-scaffolding" onclick="gtag('event', 'click_product_card', {'location': 'extreme_loads_section', 'product': 'ringlock-scaffolding'});" class="bg-slate-100 rounded-sm aspect-square relative border border-slate-200 hover:border-emerald-500 transition-colors flex items-end p-2 sm:p-3 shadow-inner group/card cursor-pointer overflow-hidden">
                  <span class="text-[9px] sm:text-[10px] font-bold text-white uppercase tracking-wider relative z-20 group-hover/card:text-emerald-400 transition-colors drop-shadow-md">Ringlock Systems</span>
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/40 to-transparent z-10"></div>
                  <Image src={img8_3} class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover/card:scale-110 transition-all duration-500" alt="Nodes" />
                </a>
              </div>
            </div>
 
            <a href="/products" onclick="gtag('event', 'click_view_products', {'location': 'extreme_loads_section'});" class="mt-auto inline-flex h-14 w-full items-center justify-center rounded-sm border border-emerald-200 bg-emerald-50 px-8 text-sm font-bold text-emerald-700 hover:bg-emerald-600 hover:text-white transition-all duration-300 uppercase tracking-widest relative z-10">
              VIEW ALL PRODUCTS
            </a>
          </div>
 
          <div class="flex flex-col bg-slate-900 rounded-lg p-8 sm:p-12 shadow-xl relative overflow-hidden border-t-4 border-emerald-500 transform hover:-translate-y-1 transition-transform duration-300 z-10 text-center lg:text-left group">
             <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-bl-full pointer-events-none z-0"></div>
             
             <div class="relative z-10 flex-grow">
               <div class="inline-flex items-center gap-2 mb-4">
                 <span class="relative flex h-3 w-3">
                   <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                   <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                 </span>
                 <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-400">Instant Pricing</span>
               </div>
 
               <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight mb-4">
                 THE <span class="text-emerald-500">QUOTE ENGINE</span>
               </h2>
               
               <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                 Skip spreadsheets and manual calculations. Get instant quotes based on your project parameters. Accurate pricing delivered instantly, zero delays.
               </p>
               
               <div class="bg-emerald-950 border-l-4 border-emerald-500 p-5 mb-8 rounded-r-sm text-left shadow-inner">
                 <p class="text-emerald-100 font-bold text-sm leading-relaxed">
                   Result: No more back-and-forth emails. Get everything you need to move forward in seconds.
                 </p>
               </div>
             </div>
             
             <a href="/quote" onclick="gtag('event', 'click_quote', {'location': 'quote_engine_card'});" class="mt-auto w-full relative inline-flex h-14 items-center justify-center rounded-sm bg-emerald-500 px-8 text-sm font-extrabold text-slate-900 shadow-md hover:bg-emerald-400 transition-colors duration-300 uppercase tracking-widest overflow-hidden z-10">
               <span class="relative z-20 flex items-center gap-2">
                 GENERATE INSTANT QUOTE &rarr;
               </span>
             </a>
          </div>
 
        </div>
      </div>
    </section>
 
    <section class="py-16 sm:py-24 border-b border-slate-200 relative overflow-hidden bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          
          <div class="order-2 lg:order-1 relative">
            <div class="relative w-full h-[400px] sm:h-[450px]">
              <div class="absolute top-0 left-0 w-3/4 h-[300px] sm:h-[350px] border border-slate-200 rounded-lg overflow-hidden shadow-md group z-10">
                <Image src={img3_1} alt="Scaffolding and Formwork Manufacturing" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" />
              </div>
              <div class="absolute bottom-0 right-0 w-2/3 h-[200px] sm:h-[250px] border-4 border-white rounded-lg overflow-hidden shadow-xl group z-20">
                <Image src={img3_2} alt="High Rise Scaffolding Execution" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" />
              </div>
              
              <div class="absolute bottom-6 left-2 sm:left-4 bg-white/95 backdrop-blur-md border border-slate-200 p-4 rounded-lg shadow-lg z-30 flex items-center gap-3 sm:gap-4">
                <span class="block text-3xl sm:text-4xl font-black text-emerald-600">26+</span>
                <span class="block text-[9px] sm:text-[10px] font-bold text-slate-700 uppercase tracking-widest leading-tight">Years of Experience<br/>In Supplying Scaffolding</span>
              </div>
            </div>
          </div>
 
          <div class="order-1 lg:order-2">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 uppercase tracking-tight mb-6 leading-tight ">
              Leading Manufacturers of<br>
              <span class="text-emerald-600">Scaffolding Staircase Towers</span><br>
              <span class="text-emerald-600">and GI Planks</span> Across India
            </h2>
            <div class="space-y-6 text-slate-600 text-sm sm:text-base leading-relaxed font-medium text-justify">
              <p>
                With a rich heritage of engineering excellence, <strong class="text-slate-900">Prime SteelTech India</strong> has evolved into a leading player in the market for manufacturing and supplying elite scaffolding and formwork materials.
              </p>
              <p>
                You will find yourself working in a true partnership that results in an incredible experience, and an end product that exceeds all load-bearing and safety compliance expectations. We specialize in precision-engineered antiskid walkway planks and heavy-duty scaffolding staircase towers designed for rapid deployment and maximum site safety.
              </p>
            </div>
            
            <ul class="mt-8 space-y-4">
              <li class="flex items-center gap-3">
                <svg class="h-5 w-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span class="text-sm font-bold text-slate-800 uppercase tracking-wide">PROVEN STRUCTURAL INTEGRITY</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="h-5 w-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span class="text-sm font-bold text-slate-800 uppercase tracking-wide">STRICT IN-HOUSE QUALITY ASSURANCE</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="h-5 w-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span class="text-sm font-bold text-slate-800 uppercase tracking-wide">ALL PRODUCTS ARE COMPLAINT WITH OSHA/EN/BS/IS STANDARDS</span>
              </li>
            </ul>
          </div>
 
        </div>
      </div>
    </section>
 
    <section class="py-16 sm:py-24 bg-slate-50 border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-16">
          <div>
            <div class="inline-flex items-center justify-center bg-emerald-100 border border-emerald-200 px-3 py-1.5 rounded-full mb-4">
              <span class="text-[10px] font-bold text-emerald-800 uppercase tracking-widest">Premium System Engineering</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mb-6 leading-tight">
              MODULAR <span class="text-emerald-600">Ringlock Scaffolding System</span> in India
            </h2>
            <div class="text-slate-600 text-sm sm:text-base leading-relaxed font-medium space-y-4 mb-8 text-justify">
              <p>
                We are recognized as one of the most reliable Scaffolding Manufacturers in India, offering superior support structures. Our flagship modular Ringlock Scaffolding System is fabricated from premium-grade materials and engineered to perform relentlessly in the most challenging project conditions.
              </p>
              <p>
                Featuring an advanced multi-directional rosette node design, our modular Ringlock systems allow up to eight connections at varying angles. This provides exemplary structural rigidity while significantly accelerating erection and dismantling times.
              </p>
            </div>
            
            <a href="/contact-us" onclick="gtag('event', 'click_contact', {'location': 'ringlock_section'});" class="inline-flex items-center justify-center rounded-sm bg-slate-900 px-6 py-3 text-xs font-bold text-white uppercase tracking-widest hover:bg-slate-800 transition-colors">
              Contact Engineering Team &rarr;
            </a>
          </div>
 
          <div class="grid grid-cols-2 gap-4 sm:gap-6 relative">
             <Image src={img4_1} class="w-full h-56 sm:h-72 object-cover rounded-lg shadow-md relative z-10" alt="Ringlock Scaffolding Structure" />
             <Image src={img4_2} class="w-full h-56 sm:h-72 object-cover rounded-lg shadow-md relative z-10 transform translate-y-6 sm:translate-y-8" alt="Industrial Ringlock Nodes" />
          </div>
        </div>
 
        <div class="bg-white border border-slate-200 rounded-lg p-8 sm:p-12 shadow-sm relative overflow-hidden mt-12 sm:mt-24">
           <h3 class="text-xl sm:text-2xl font-black text-slate-900 uppercase tracking-tight mb-10 text-center sm:text-left relative z-10">
             Best <span class="text-emerald-600">Scaffolding Staircase Towers</span> and <span class="text-emerald-600">AntiSkid Walkway Planks</span> in India
           </h3>
 
           <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 relative z-10">
             <div class="flex flex-col sm:flex-row gap-6 items-start group">
                <div class="w-full sm:w-40 h-40 shrink-0 rounded-md overflow-hidden border border-slate-200 relative">
                  <Image src={img4_3} class="w-full h-full object-cover transform group-hover:scale-110 transition-duration-500" alt="Scaffolding Staircase Towers" />
                </div>
                <div>
                  <h4 class="text-slate-900 font-bold uppercase tracking-wider mb-2 text-sm group-hover:text-emerald-600 transition-colors">SCAFFOLDING STAIRCASE TOWERS</h4>
                  <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-2 text-justify">

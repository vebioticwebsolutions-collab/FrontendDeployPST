<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const productCards = document.querySelectorAll('.product-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset all buttons to inactive state
        filterBtns.forEach(b => {
            b.classList.remove('bg-emerald-600', 'text-white', 'active', 'shadow-md');
            b.classList.add('border', 'border-slate-300', 'bg-white', 'text-slate-600', 'shadow-sm');
        });
        
        // Set clicked button to active state
        btn.classList.remove('border', 'border-slate-300', 'bg-white', 'text-slate-600', 'shadow-sm');
        btn.classList.add('bg-emerald-600', 'text-white', 'active', 'shadow-md');

        const filterValue = btn.getAttribute('data-filter');

        // Filter the cards
        productCards.forEach(card => {
          if (filterValue === 'all' || card.getAttribute('data-category') === filterValue) {
            card.style.display = 'flex';
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'scale(1)';
            }, 50);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
            setTimeout(() => {
              card.style.display = 'none';
            }, 300); 
          }
        });
      });
    });

    // SALES PHONE DROPDOWN
    const salesWrapper = document.getElementById('sales-dropdown-wrapper-products');
    const salesBtn = document.getElementById('sales-dropdown-btn-products');
    const salesMenu = document.getElementById('sales-dropdown-menu-products');
    const salesChevron = document.getElementById('sales-dropdown-chevron-products');

    if (salesBtn && salesMenu && salesWrapper) {
      salesBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !salesMenu.classList.contains('hidden');
        salesMenu.classList.toggle('hidden');
        salesBtn.setAttribute('aria-expanded', String(!isOpen));
        if (salesChevron) salesChevron.classList.toggle('rotate-180', !isOpen);
      });

      document.addEventListener('click', (e) => {
        if (!salesWrapper.contains(e.target)) {
          salesMenu.classList.add('hidden');
          salesBtn.setAttribute('aria-expanded', 'false');
          if (salesChevron) salesChevron.classList.remove('rotate-180');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          salesMenu.classList.add('hidden');
          salesBtn.setAttribute('aria-expanded', 'false');
          if (salesChevron) salesChevron.classList.remove('rotate-180');
        }
      });
    }
  });
</script>
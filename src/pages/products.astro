---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// ==========================================
// 1. FLAGSHIP IMPORTS (Options 1 & 2)
// ==========================================
import ringlockOpt1 from '../assets/products/Ringlock Option 1.jpeg';
import ringlockOpt2 from '../assets/products/(updated)Ringlock Option 2.jpg';
import towerFeatured from '../assets/staircase/staircase tower main photo.jpg';
import plankOpt1 from '../assets/products/Premium Industrial Walkway Planks Section Punched matrix image (1).jpg';
import plankOpt2 from '../assets/products/(updated) Walkway Plank Option 2 .jpg';

// ==========================================
// 2. FULL CATALOGUE IMPORTS (19 Items)
// ==========================================
import anchorNut from '../assets/products/anchor-nut product.jpg';
import baseJack from '../assets/products/base-jack product.jpg';
import cuplock from '../assets/products/updated cuplock image.jpg';
import doubleCoupler from '../assets/products/double coupler.jpg';
import expJointPin from '../assets/products/exp-joint-pin product.jpg';
import fixedBasePlate from '../assets/products/fixed-base-plate product.jpg';
import floorformPanels from '../assets/products/floorform-panels-highres product.jpg';
import girderCoupler from '../assets/products/girder-coupler.jpg';
import gratings from '../assets/products/gratings-highres product.jpg';
import hFrame from '../assets/products/h frame product.jpg';
import ringlockProd from '../assets/products/(updated) Ringlock product (1).png';
import sleeveCoupler from '../assets/products/sleeve coupler.png'; 
import staircaseProd from '../assets/products/Mini Apex Tower Orange White BG.jpg';
import stirrupHead from '../assets/products/stirrup head.jpg';
import swivelCoupler from '../assets/products/swivel coupler.jpg';
import telescopicProp from '../assets/products/telescopic steel prop.jpg';
import tieRod from '../assets/products/tie-rod product.jpg';
import universalJack from '../assets/products/universal jack product.jpg';
import walkwayPlank from '../assets/home-page/walkway buyer guide image.jpg';
import brc from '../assets/products/brc.jpg';

// Unified Product Data Engine for the Interactive Grid
const products = [
  // Scaffolding Systems
  {
    name: "Staircase Towers",
    category: "scaffolding",
    image: staircaseProd,
    specs: ["High-volume worker egress", "Interlocking stringers", "OSHA compliant landings"]
  },
  {
    name: "Walkway Planks",
    category: "scaffolding",
    image: walkwayPlank,
    specs: ["Punched anti-slip surface", "Roll-formed structural rigidity", "Heavy-duty load rating"]
  },
  {
    name: "Board retaining clamp (BRC)",
    category: "hardware",
    image: brc,
    specs: ["Secures tie-rods tightly", "Wide load distribution", "Cast iron durability"]
  },
  {
    name: "Ringlock Scaffolding",
    category: "scaffolding",
    image: ringlockProd,
    specs: ["Multi-directional rosette nodes", "Up to 8 connections per node", "High load-bearing capacity"]
  },
  {
    name: "Cuplock Scaffolding",
    category: "scaffolding",
    image: cuplock,
    specs: ["Rapid locking mechanism", "Galvanized rust resistance", "Rigid node points"]
  },
  {
    name: "Telescopic Steel Prop",
    category: "pipes",
    image: telescopicProp,
    specs: ["Infinite height adjustment", "Self-cleaning heavy duty thread", "Solid base and head plates"]
  },
  {
    name: "H-Frame Scaffolding",
    category: "scaffolding",
    image: hFrame,
    specs: ["Ideal for masonry & painting", "Rigid cross-bracing", "Quick vertical stacking"]
  },
  {
    name: "Industrial Gratings",
    category: "scaffolding",
    image: gratings,
    specs: ["Heavy impact resistance", "High drainage capability", "Non-slip serrated edge"]
  },

  // Pipes & Props


  // Formwork
  {
    name: "Floorform Panels",
    category: "formwork",
    image: floorformPanels,
    specs: ["Uniform concrete finish", "Stiffened with MS angles", "Seamless interlocking edges"]
  },

  // Hardware
  {
    name: "Double Coupler",
    category: "hardware",
    image: doubleCoupler,
    specs: ["90-degree rigid connection", "BS 1139 standard compliance", "Slip-resistant grip"]
  },
  {
    name: "Swivel Coupler",
    category: "hardware",
    image: swivelCoupler,
    specs: ["360-degree rotation", "Connects bracing tubes", "Drop-forged durability"]
  },
  {
    name: "Girder Coupler",
    category: "hardware",
    image: girderCoupler,
    specs: ["Secures tubes to beams", "Heavy duty clamping", "Used in pairs"]
  },
  {
    name: "Sleeve Coupler",
    category: "hardware",
    image: sleeveCoupler,
    specs: ["End-to-end external connection", "Maintains tube alignment", "High tensile steel"]
  },
  {
    name: "Base Jack",
    category: "hardware",
    image: baseJack,
    specs: ["Leveling on uneven ground", "Heavy duty threaded rod", "Solid load distribution"]
  },
  {
    name: "Universal Jack",
    category: "hardware",
    image: universalJack,
    specs: ["Top and bottom application", "Fits multiple tube sizes", "Precision height control"]
  },
  {
    name: "Fixed Base Plate",
    category: "hardware",
    image: fixedBasePlate,
    specs: ["Spreads load evenly", "Welded central spigot", "Flat concrete placement"]
  },
  {
    name: "Stirrup Head",
    category: "hardware",
    image: stirrupHead,
    specs: ["Holds timber or steel beams", "U-head configuration", "Seamless height adjustment"]
  },
  {
    name: "Expansion Joint Pin",
    category: "hardware",
    image: expJointPin,
    specs: ["Internal end-to-end jointing", "Expanding core mechanism", "Perfect tube alignment"]
  },
  {
    name: "Tie-Rod Array",
    category: "hardware",
    image: tieRod,
    specs: ["High tensile formwork anchor", "Continuous threading", "Resists high pour pressure"]
  },
  {
    name: "Anchor Nut",
    category: "hardware",
    image: anchorNut,
    specs: ["Secures tie-rods tightly", "Wide load distribution", "Cast iron durability"]
  },
];

// ==========================================
// DYNAMIC CATALOGUE SCHEMA (SEO/GEO)
// ==========================================
const catalogueSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Prime SteelTech India Pvt Ltd Product Catalogue",
  "url": "https://primesteeltech.co.in/products",
  "description": "Complete catalogue of BIS-approved Ringlock scaffolding, formwork, pipes, props, and hardware.",
  "itemListElement": products.map((product, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": product.name,
      "category": product.category,
      "description": `Features: ${product.specs.join(', ')}`,
      "brand": {
        "@type": "Brand",
        "name": "Prime SteelTech India Pvt Ltd"
      }
    }
  }))
};
---

<Layout title="Prime SteelTech Products | Top Scaffolding & Formwork Systems in India">
  
  <script type="application/ld+json" set:html={JSON.stringify(catalogueSchema)} />

  <main class="bg-slate-50 min-h-screen text-slate-900 font-jakarta">
    
    <section class="relative pt-24 pb-12 text-center overflow-hidden border-b border-slate-200">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-500/10 blur-[120px] rounded-full pointer-events-none"></div>
      
      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-white/60 backdrop-blur-sm px-4 py-2 text-[11px] font-bold text-emerald-700 uppercase tracking-widest mb-6 shadow-sm">
          Top Scaffolding Manufacturer in India
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black text-slate-900 uppercase tracking-tight mb-4 drop-shadow-sm">
          Product <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-700">Catalogue</span>
        </h1>
        <p class="text-slate-600 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed font-medium">
          The best in India. Engineered for extreme loads and absolute safety. 
        </p>
      </div>
    </section>

    <section class="pb-16 pt-8 relative z-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="bg-white/60 backdrop-blur-xl border border-white rounded-2xl p-8 sm:p-12 shadow-[0_20px_50px_rgba(0,0,0,0.05)] relative overflow-hidden flex flex-col lg:flex-row items-center justify-between gap-10">
          
          <div class="absolute right-0 top-1/2 -translate-y-1/2 w-64 h-64 bg-emerald-500/10 blur-[80px] pointer-events-none"></div>

          <div class="text-center lg:text-left lg:max-w-xl relative z-10">
            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-[10px] font-bold text-emerald-800 uppercase tracking-widest mb-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
              Official 2026 Edition
            </div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 uppercase tracking-tight mb-4 leading-tight">
              The Prime SteelTech <span class="text-emerald-600">Buyer's Guide</span>
            </h2>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-medium mb-0">
              Before configuring your logistics, download our comprehensive engineering document. Contains complete specifications, load-bearing matrices, material grades, and BIS/OSHA compliance data for all systems.
            </p>
          </div>

          <div class="flex flex-col w-full lg:w-auto gap-4 relative z-10 shrink-0">
            
            <a href="/buyer's-guide" class="w-full inline-flex h-14 items-center justify-center gap-2 rounded-sm bg-gradient-to-b from-emerald-600 to-emerald-800 border border-emerald-900 px-8 text-sm font-black text-white shadow-[0_8px_20px_rgba(16,185,129,0.25)] hover:-translate-y-0.5 transition-all duration-300 uppercase tracking-widest">
              <svg class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Download Guide
            </a>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <a href="/contact-us" class="inline-flex h-12 items-center justify-center rounded-sm border border-slate-300 bg-white px-4 text-[10px] font-bold text-slate-700 hover:border-emerald-500 hover:text-emerald-700 shadow-sm transition-all uppercase tracking-widest text-center">
                Get In Touch
              </a>
              <div class="relative" id="sales-dropdown-wrapper-products">
                <button type="button" id="sales-dropdown-btn-products" class="w-full inline-flex h-12 items-center justify-center gap-1.5 rounded-sm border border-slate-300 bg-white px-4 text-[10px] font-bold text-slate-700 hover:border-emerald-500 hover:text-emerald-700 shadow-sm transition-all uppercase tracking-widest text-center focus:outline-none" aria-haspopup="true" aria-expanded="false" aria-label="Call Sales">
                  Call Sales
                  <svg id="sales-dropdown-chevron-products" class="h-3 w-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                </button>

                <div id="sales-dropdown-menu-products" class="hidden absolute top-full left-0 sm:right-0 sm:left-auto mt-2 w-56 origin-top z-50">
                  <div class="rounded-sm bg-white p-2 shadow-[0_15px_40px_rgba(0,0,0,0.15)] ring-1 ring-slate-200 border-t-4 border-emerald-500">
                    <a href="tel:+919393161504" class="flex items-center gap-3 rounded-sm px-4 py-3 text-[11px] font-bold uppercase tracking-widest text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
                      <svg class="h-4 w-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                      +91 93931 61504
                    </a>
                    <a href="tel:+919322321421" class="flex items-center gap-3 rounded-sm px-4 py-3 text-[11px] font-bold uppercase tracking-widest text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
                      <svg class="h-4 w-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                      +91 93223 21421
                    </a>
                    <a href="tel:+919373416890" class="flex items-center gap-3 rounded-sm px-4 py-3 text-[11px] font-bold uppercase tracking-widest text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
                      <svg class="h-4 w-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                      +91 9324560020
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
        <section class="py-20 sm:py-24 border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-stretch">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
            <div class="relative rounded-lg bg-slate-100 border border-slate-200 shadow-md overflow-hidden group min-h-[300px] sm:min-h-full">
              <Image src={plankOpt1} alt="Walkway Plank Option 1" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-700 ease-out z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent z-10"></div>
              <div class="absolute bottom-3 left-3 bg-white/90 border border-slate-200 px-3 py-1 text-[10px] font-bold text-slate-800 uppercase tracking-widest rounded-sm backdrop-blur-sm z-20 shadow-sm">Without Hook</div>
            </div>
            <div class="relative rounded-lg bg-slate-100 border border-slate-200 shadow-md overflow-hidden group min-h-[300px] sm:min-h-full">
              <Image src={plankOpt2} alt="Walkway Plank Option 2" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-700 ease-out z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent z-10"></div>
              <div class="absolute bottom-3 left-3 bg-white/90 border border-slate-200 px-3 py-1 text-[10px] font-bold text-slate-800 uppercase tracking-widest rounded-sm backdrop-blur-sm z-20 shadow-sm">With Hook</div>
            </div>
          </div>

          <div class="flex flex-col justify-center">
            <h2 class="text-3xl sm:text-4xl font-black text-slate-900 uppercase tracking-tight mb-4">Anti-skid GI <br/><span class="text-emerald-600">Walkway Planks</span></h2>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-8 font-medium">
              The foundation of safe elevation. Our heavy-duty steel walkway planks are roll-formed for structural rigidity, providing workers with an unyielding, secure platform at any height.
            </p>
            
            <div class="space-y-3 mb-10">
              <div class="flex items-start gap-4 p-4 rounded-lg bg-slate-50 border border-slate-200 hover:border-emerald-400 hover:shadow-md transition-all duration-300">
                <svg class="h-6 w-6 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"/></svg>
                <div>
                  <h4 class="text-slate-900 text-sm font-bold uppercase tracking-wider mb-1">Maximum Surface Grip</h4>
                  <p class="text-xs text-slate-500 leading-relaxed font-medium">Aggressive punched, anti-slip surface matrix ensures superior boot traction even in wet or oily conditions.</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4 p-4 rounded-lg bg-slate-50 border border-slate-200 hover:border-emerald-400 hover:shadow-md transition-all duration-300">
                <svg class="h-6 w-6 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                <div>
                  <h4 class="text-slate-900 text-sm font-bold uppercase tracking-wider mb-1">Unwarping Durability</h4>
                  <p class="text-xs text-slate-500 leading-relaxed font-medium">Structural ribs designed to prevent bending and material fatigue under sustained heavy material storage.</p>
                </div>
              </div>
            </div>

            <a href="/products/walkway-planks" class="relative group inline-flex h-14 items-center justify-center rounded-sm bg-slate-900 px-10 text-sm font-extrabold text-white shadow-lg hover:shadow-xl hover:bg-emerald-600 transition-all duration-300 uppercase tracking-widest w-full sm:w-auto">
              Learn More &rarr;
            </a>
          </div>

        </div>
      </div>
    </section>

        <section class="py-20 sm:py-24 border-b border-slate-200 bg-slate-50 relative overflow-hidden">
      <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-500/5 blur-[100px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-stretch">
          
          <div class="order-2 lg:order-1 flex flex-col justify-center">
            <h2 class="text-3xl sm:text-4xl font-black text-slate-900 uppercase tracking-tight mb-4">Best Scaffolding <br/><span class="text-emerald-600">Staircase Towers</span></h2>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-8 font-medium">
              Safe, high-capacity access solutions for multi-level construction and industrial sites. Our scaffolding staircase towers are built to withstand heavy foot traffic and extreme environmental conditions without compromising stability.
            </p>
            
            <div class="space-y-3 mb-10">
              <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-slate-200 hover:border-emerald-400 hover:shadow-md transition-all duration-300">
                <svg class="h-6 w-6 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <div>
                  <h4 class="text-slate-900 text-sm font-bold uppercase tracking-wider mb-1">Extreme Load Ratings</h4>
                  <p class="text-xs text-slate-500 leading-relaxed font-medium">Engineered specifically to support high-density worker movement and heavy tool transport simultaneously.</p>
                </div>
              </div>
              
              <div class="flex items-start gap-4 p-4 rounded-lg bg-white border border-slate-200 hover:border-emerald-400 hover:shadow-md transition-all duration-300">
                <svg class="h-6 w-6 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <div>
                  <h4 class="text-slate-900 text-sm font-bold uppercase tracking-wider mb-1">Safety Integrated</h4>
                  <p class="text-xs text-slate-500 leading-relaxed font-medium">Features heavy-duty interlocking handrails and anti-slip tread surfaces to eliminate site hazard risks.</p>
                </div>
              </div>
            </div>

            <a href="/products/staircase-tower" class="relative group inline-flex h-14 items-center justify-center rounded-sm bg-slate-900 px-10 text-sm font-extrabold text-white shadow-lg hover:shadow-xl hover:bg-emerald-600 transition-all duration-300 uppercase tracking-widest w-full sm:w-auto">
              Learn More &rarr;
            </a>
          </div>

          <div class="order-1 lg:order-2 aspect-[4/3] rounded-lg bg-slate-100 border border-slate-200 shadow-md relative overflow-hidden group">
            <Image src={towerFeatured} alt="Staircase Tower Setup" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-700 ease-out z-0" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent z-10"></div>
          </div>

        </div>
      </div>
    </section>


    <section class="py-20 sm:py-24 border-b border-slate-200 relative overflow-hidden bg-white">
      <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-500/5 blur-[100px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-stretch">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
            <div class="relative rounded-lg bg-slate-100 border border-slate-200 shadow-md overflow-hidden group min-h-[300px] sm:min-h-full">
              <Image src={ringlockOpt1} alt="Ringlock Option 1" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-all duration-700 ease-out z-0" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent z-10"></div>

            </div>
